FROM ghcr.io/project-everest/everparse:v2026.03.21

USER root

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PATH="/app/.venv/bin:${PATH}"
ENV EVERPARSE_SCRIPT_PATH=/usr/local/bin/everparse.sh
ENV EXTRA_APT_PACKAGES="python3 python3-pip python3-venv"
ENV PIP_BIN=pip3
ENV PIP_INSTALL_ARGS=--break-system-packages

COPY docker/install_app.sh /tmp/install_app.sh
COPY docker/everparse.sh /usr/local/bin/everparse.sh
COPY pyproject.toml uv.lock ./
RUN /bin/sh /tmp/install_app.sh \
    && chmod +x /usr/local/bin/everparse.sh

COPY . .
RUN uv sync --locked --no-dev
