IDENT_gpt::IDENT {
  messages: [
    IDENT_gpt::Message {
      port_pair: IDENT_gpt::PortPair {
        port_on_server: 993
        port_on_client: 51515
      }
      userid: IDENT_gpt::UserIDTail {
        resp_type: USERID
        opsys: OTHER
        charset: (unset)
        user_id:  encrypted-user-token
        has_charset: False
      }
      error: (unset)
    }
  ]
}
