# Define the main message unit
public type IRCMessage = unit {
    prefix_present: uint8 &convert=($$ == b':') &requires=($$ == True or $$ == False);
    switch (self.prefix_present) {
        True -> prefix: Prefix;
        False -> : void;
    };
    command: CommandName;
    params: Params;
    crlf: b"\r\n";
};

# Define the prefix unit
type Prefix = unit {
    servername_or_nick: ServernameOrNick;
    switch (self.servername_or_nick.type_value) {
        Servername -> : void;
        Nick -> user_part: UserPart;
    };
};

# Define servername or nick
type ServernameOrNick = unit {
    value: bytes &until=b' ' &convert=$$.decode();
    type_value: uint8 &convert=($$.startswith(b'#') or $$.startswith(b'&') ? Servername : Nick);
};

# Define user part
type UserPart = unit {
    user: bytes &until=b'@' &convert=$$.decode();
    host: bytes &until=b' ' &convert=$$.decode();
};

# Define command name
type CommandName = unit {
    value: bytes &until=b' ' &convert=$$.decode();
    command_type: Command &convert=Command($$.upper());
};

# Define parameters
type Params = unit {
    param_list: ParamList[];
    : b"\r\n";
};

# Define parameter list
type ParamList = unit {
    middle_or_trailing: MiddleOrTrailing;
};

# Define middle or trailing
type MiddleOrTrailing = unit {
    switch (self.is_trailing) {
        True -> trailing: Trailing;
        False -> middle: Middle;
    };
};

# Define if it's trailing
type IsTrailing = unit {
    is_trailing: uint8 &convert=($$ == b':');
};

# Define trailing
type Trailing = unit {
    value: bytes &until=b'\r\n' &convert=$$.decode();
};

# Define middle
type Middle = unit {
    value: bytes &until=b' ' &convert=$$.decode();
};