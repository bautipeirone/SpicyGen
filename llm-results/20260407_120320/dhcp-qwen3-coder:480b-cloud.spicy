module DHCP;

import spicy;

type Opcode = enum {
    BOOTREQUEST = 1,
    BOOTREPLY = 2,
};

type HwType = enum {
    ETHERNET = 1,
    OTHER = 2,
};

type MessageType = enum {
    DHCPDISCOVER = 1,
    DHCPOFFER = 2,
    DHCPREQUEST = 3,
    DHCPDECLINE = 4,
    DHCPACK = 5,
    DHCPNAK = 6,
    DHCPRELEASE = 7,
    DHCPINFORM = 8,
};

type DhcpFlags = unit {
    f: bitfield(16) {
        broadcast: 0;
        mbz: 1..15;
    } &bit-order=spicy::BitOrder::MSB0;
};

type Option = unit {
    code: uint8;
    len: uint8 if(self.code != 0 && self.code != 255);
    data: bytes &size=self.len if(self.code != 0 && self.code != 255);
};

type Options = unit {
    magic_cookie: uint32 &requires=($$ == 0x63825363);
    options: Option[] &eod;
};

type DhcpPacket = unit {
    op: uint8 &convert=Opcode($$);
    htype: uint8 &convert=HwType($$);
    hlen: uint8 &requires=($$ <= 16);
    hops: uint8;
    xid: uint32;
    secs: uint16;
    flags: DhcpFlags;
    ciaddr: addr &ipv4;
    yiaddr: addr &ipv4;
    siaddr: addr &ipv4;
    giaddr: addr &ipv4;
    chaddr: bytes &size=16;
    sname: bytes &size=64 &convert=$$.split1(b"\0")[0].decode();
    filename: bytes &size=128 &convert=$$.split1(b"\0")[0].decode();
    options: Options;
};

public type Dhcp = unit {
    packet: DhcpPacket;
};