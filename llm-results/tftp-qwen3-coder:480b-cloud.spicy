module tftp;

public type Packet = unit {
    opcode: uint16;
    switch ( self.opcode ) {
        1 -> : RRQ;
        2 -> : WRQ;
        3 -> : DATA;
        4 -> : ACK;
        5 -> : ERROR;
        * -> : void;
    };
};

type RRQ = unit {
    filename: bytes &until=b"\x00";
    mode: bytes &until=b"\x00" &requires=($$ == b"netascii" || $$ == b"octet" || $$ == b"mail");
};

type WRQ = unit {
    filename: bytes &until=b"\x00";
    mode: bytes &until=b"\x00" &requires=($$ == b"netascii" || $$ == b"octet" || $$ == b"mail");
};

type DATA = unit {
    block_number: uint16;
    data: bytes &size=512;
};

type ACK = unit {
    block_number: uint16;
};

type ERROR = unit {
    error_code: uint16;
    error_msg: bytes &until=b"\x00";
};