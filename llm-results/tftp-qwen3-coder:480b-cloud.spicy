module TFTP;

public type Opcode = enum {
    RRQ = 1,
    WRQ = 2,
    DATA = 3,
    ACK = 4,
    ERROR = 5,
};

public type ErrorCode = enum {
    UNDEFINED = 0,
    FILE_NOT_FOUND = 1,
    ACCESS_VIOLATION = 2,
    DISK_FULL = 3,
    ILLEGAL_OPERATION = 4,
    UNKNOWN_TRANSFER_ID = 5,
    FILE_EXISTS = 6,
    NO_SUCH_USER = 7,
};

type Mode = enum {
    NETASCII,
    OCTET,
    MAIL,
};

public type RRQ = unit {
    opcode: uint16 &convert=Opcode($$);
    filename: bytes &size=1 &until=b"\0" &convert=$$.split1(b"\0")[0].decode();
    mode: bytes &size=1 &until=b"\0" &convert=$$.split1(b"\0")[0].decode() &requires=(self.opcode == Opcode::RRQ);
};

public type WRQ = unit {
    opcode: uint16 &convert=Opcode($$);
    filename: bytes &size=1 &until=b"\0" &convert=$$.split1(b"\0")[0].decode();
    mode: bytes &size=1 &until=b"\0" &convert=$$.split1(b"\0")[0].decode() &requires=(self.opcode == Opcode::WRQ);
};

public type DATA = unit {
    opcode: uint16 &convert=Opcode($$) &requires=($$ == 3);
    block_number: uint16;
    data: bytes &size=512;
};

public type ACK = unit {
    opcode: uint16 &convert=Opcode($$) &requires=($$ == 4);
    block_number: uint16;
};

public type ERROR = unit {
    opcode: uint16 &convert=Opcode($$) &requires=($$ == 5);
    error_code: uint16 &convert=ErrorCode($$);
    error_msg: bytes &size=1 &until=b"\0" &convert=$$.split1(b"\0")[0].decode();
};