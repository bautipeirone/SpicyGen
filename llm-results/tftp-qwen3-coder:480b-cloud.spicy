module TFTP;

public type Packet = unit {
    opcode: uint16;
    switch ( self.opcode ) {
        1 -> rrq: RRQ;
        2 -> wrq: WRQ;
        3 -> data: DATA;
        4 -> ack: ACK;
        5 -> error: ERROR;
        * -> : bytes &eod;
    };
};

type RRQ = unit {
    filename: bytes &until=b"\x00";
    mode: bytes &until=b"\x00";
};

type WRQ = unit {
    filename: bytes &until=b"\x00";
    mode: bytes &until=b"\x00";
};

type DATA = unit {
    block_num: uint16;
    data: bytes &size=512;
};

type ACK = unit {
    block_num: uint16;
};

type ERROR = unit {
    error_code: uint16;
    error_msg: bytes &until=b"\x00";
};