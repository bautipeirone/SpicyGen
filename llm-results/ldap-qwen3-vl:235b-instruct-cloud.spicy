module LDAP;

# Common types and structures

public type LDAPString = bytes;
public type LDAPOID = bytes;
public type LDAPDN = LDAPString;
public type RelativeLDAPDN = LDAPString;
public type AttributeDescription = LDAPString;
public type AttributeValue = bytes;
public type AssertionValue = bytes;
public type MatchingRuleId = LDAPString;

public type MessageID = int32 &requires=($$ >= 0 && $$ <= 2147483647);

public type LDAPResult = unit {
    resultCode: int32 &requires=($$ >= 0 && $$ <= 80);
    matchedDN: LDAPDN;
    diagnosticMessage: LDAPString;
    referral: Referral &optional;
};

public type Referral = unit {
    uris: URI[];
};

public type URI = LDAPString;

public type Controls = unit {
    controls: Control[];
};

public type Control = unit {
    controlType: LDAPOID;
    criticality: bool &default=false;
    controlValue: bytes &optional;
};

# Bind Operation

public type BindRequest = unit {
    version: int8 &requires=($$ >= 1 && $$ <= 127);
    name: LDAPDN;
    authentication: AuthenticationChoice;
};

public type AuthenticationChoice = unit {
    choice: int8 &size=1;
    switch (self.choice) {
        b"\x00" -> simple: bytes;
        b"\x03" -> sasl: SaslCredentials;
        * -> : void; # Unknown or reserved choices
    };
};

public type SaslCredentials = unit {
    mechanism: LDAPString;
    credentials: bytes &optional;
};

public type BindResponse = unit {
    result: LDAPResult;
    serverSaslCreds: bytes &optional &tag=7;
};

# Unbind Operation

public type UnbindRequest = unit {
    # No fields, just a tag
};

# Search Operation

public type SearchRequest = unit {
    baseObject: LDAPDN;
    scope: int8 &requires=($$ >= 0 && $$ <= 2);
    derefAliases: int8 &requires=($$ >= 0 && $$ <= 3);
    sizeLimit: int32 &requires=($$ >= 0 && $$ <= 2147483647);
    timeLimit: int32 &requires=($$ >= 0 && $$ <= 2147483647);
    typesOnly: bool;
    filter: Filter;
    attributes: AttributeSelection;
};

public type AttributeSelection = unit {
    selectors: LDAPString[];
};

public type Filter = unit {
    choice: int8 &size=1;
    switch (self.choice) {
        b"\x00" -> and: Filter[] &tag=0;
        b"\x01" -> or: Filter[] &tag=1;
        b"\x02" -> not: Filter &tag=2;
        b"\x03" -> equalityMatch: AttributeValueAssertion &tag=3;
        b"\x04" -> substrings: SubstringFilter &tag=4;
        b"\x05" -> greaterOrEqual: AttributeValueAssertion &tag=5;
        b"\x06" -> lessOrEqual: AttributeValueAssertion &tag=6;
        b"\x07" -> present: AttributeDescription &tag=7;
        b"\x08" -> approxMatch: AttributeValueAssertion &tag=8;
        b"\x09" -> extensibleMatch: MatchingRuleAssertion &tag=9;
        * -> : void; # Unknown or reserved choices
    };
};

public type AttributeValueAssertion = unit {
    attributeDesc: AttributeDescription;
    assertionValue: AssertionValue;
};

public type SubstringFilter = unit {
    type: AttributeDescription;
    substrings: SubstringComponent[];
};

public type SubstringComponent = unit {
    choice: int8 &size=1;
    switch (self.choice) {
        b"\x00" -> initial: AssertionValue &tag=0;
        b"\x01" -> any: AssertionValue &tag=1;
        b"\x02" -> final: AssertionValue &tag=2;
        * -> : void; # Unknown or reserved choices
    };
};

public type MatchingRuleAssertion = unit {
    matchingRule: MatchingRuleId &optional &tag=1;
    type: AttributeDescription &optional &tag=2;
    matchValue: AssertionValue &tag=3;
    dnAttributes: bool &default=false &tag=4;
};

public type SearchResultEntry = unit {
    objectName: LDAPDN;
    attributes: PartialAttributeList;
};

public type PartialAttributeList = unit {
    partialAttributes: PartialAttribute[];
};

public type PartialAttribute = unit {
    type: AttributeDescription;
    vals: AttributeValue[];
};

public type SearchResultReference = unit {
    uris: URI[];
};

public type SearchResultDone = LDAPResult;

# Modify Operation

public type ModifyRequest = unit {
    object: LDAPDN;
    changes: ModifyChange[];
};

public type ModifyChange = unit {
    operation: int8 &requires=($$ >= 0 && $$ <= 2);
    modification: PartialAttribute;
};

public type ModifyResponse = LDAPResult;

# Add Operation

public type AddRequest = unit {
    entry: LDAPDN;
    attributes: Attribute[];
};

public type Attribute = unit {
    type: AttributeDescription;
    vals: AttributeValue[];
};

public type AddResponse = LDAPResult;

# Delete Operation

public type DelRequest = LDAPDN;

public type DelResponse = LDAPResult;

# Modify DN Operation

public type ModifyDNRequest = unit {
    entry: LDAPDN;
    newrdn: RelativeLDAPDN;
    deleteoldrdn: bool;
    newSuperior: LDAPDN &optional &tag=0;
};

public type ModifyDNResponse = LDAPResult;

# Compare Operation

public type CompareRequest = unit {
    entry: LDAPDN;
    ava: AttributeValueAssertion;
};

public type CompareResponse = LDAPResult;

# Abandon Operation

public type AbandonRequest = MessageID;

# Extended Operation

public type ExtendedRequest = unit {
    requestName: LDAPOID &tag=0;
    requestValue: bytes &optional &tag=1;
};

public type ExtendedResponse = unit {
    result: LDAPResult;
    responseName: LDAPOID &optional &tag=10;
    responseValue: bytes &optional &tag=11;
};

# IntermediateResponse

public type IntermediateResponse = unit {
    responseName: LDAPOID &optional &tag=0;
    responseValue: bytes &optional &tag=1;
};

# StartTLS Operation (Extended Operation)

public type StartTLSRequest = ExtendedRequest;
public type StartTLSResponse = ExtendedResponse;

# LDAPMessage Envelope

public type LDAPMessage = unit {
    messageID: MessageID;
    protocolOp: ProtocolOp;
    controls: Controls &optional &tag=0;
};

public type ProtocolOp = unit {
    choice: int8 &size=1;
    switch (self.choice) {
        b"\x00" -> bindRequest: BindRequest;
        b"\x01" -> bindResponse: BindResponse;
        b"\x02" -> unbindRequest: UnbindRequest;
        b"\x03" -> searchRequest: SearchRequest;
        b"\x04" -> searchResEntry: SearchResultEntry;
        b"\x05" -> searchResDone: SearchResultDone;
        b"\x13" -> searchResRef: SearchResultReference;
        b"\x06" -> modifyRequest: ModifyRequest;
        b"\x07" -> modifyResponse: ModifyResponse;
        b"\x08" -> addRequest: AddRequest;
        b"\x09" -> addResponse: AddResponse;
        b"\x0A" -> delRequest: DelRequest;
        b"\x0B" -> delResponse: DelResponse;
        b"\x0C" -> modDNRequest: ModifyDNRequest;
        b"\x0D" -> modDNResponse: ModifyDNResponse;
        b"\x0E" -> compareRequest: CompareRequest;
        b"\x0F" -> compareResponse: CompareResponse;
        b"\x10" -> abandonRequest: AbandonRequest;
        b"\x17" -> extendedReq: ExtendedRequest;
        b"\x18" -> extendedResp: ExtendedResponse;
        b"\x19" -> intermediateResponse: IntermediateResponse;
        * -> : void; # Unknown or reserved choices
    };
};