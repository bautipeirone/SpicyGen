module HTTP;

# Basic tokens and constants
const SP = / /;
const HT = /\t/;
const CR = /\r/;
const LF = /\n/;
const CRLF = /\r\n/;
const LWS = /[ \t]+/;
const token = /[!#$%&'*+\-.0-9A-Z^_`a-z|~]+/;
const quoted_string = /"([^"\\]|\\.)*"/;
const comment = /\(([^()\\]|\\.)*\)/;

# HTTP version
type HTTPVersion = unit {
    : b"HTTP/";
    major: uint8 &convert=$$.to_uint();
    : b".";
    minor: uint8 &convert=$$.to_uint();
};

# Date/time formats (RFC 1123, RFC 850, asctime)
const wkday = /Mon|Tue|Wed|Thu|Fri|Sat|Sun/;
const weekday = /Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday/;
const month = /Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec/;
const time_regex = /[0-9]{2}:[0-9]{2}:[0-9]{2}/;
const date1 = /[0-9]{2} [A-Za-z]{3} [0-9]{4}/;
const date2 = /[0-9]{2}-[A-Za-z]{3}-[0-9]{2}/;
const date3 = /[A-Za-z]{3} [0-9]{1,2}/;

type HTTPDate = unit {
    switch {
        -> rfc1123: wkday b", " date1 SP time SP b"GMT";
        -> rfc850: weekday b", " date2 SP time SP b"GMT";
        -> asctime: wkday SP date3 SP time SP /[0-9]{4}/;
    };
};

# URI (simplified)
const absoluteURI = /[a-zA-Z][a-zA-Z0-9+.-]*:\/\/[^ \t\r\n]+/;
const abs_path = /\/[^ \t\r\n]*/;
const authority = /[^ \t\r\n@]+@[^ \t\r\n]+/;

# Request line
type RequestLine = unit {
    method: token;
    : SP;
    request_uri: switch {
        -> asterisk: b"*";
        -> absolute: absoluteURI;
        -> abs_path: abs_path;
        -> authority: authority;
    };
    : SP;
    http_version: HTTPVersion;
    : CRLF;
};

# Status line
type StatusLine = unit {
    http_version: HTTPVersion;
    : SP;
    status_code: uint16 &convert=$$.to_uint();
    : SP;
    reason_phrase: bytes &until=CRLF;
    : CRLF;
};

# Header field
type HeaderField = unit {
    field_name: token;
    : b":";
    : LWS?;
    field_value: bytes &until=CRLF;
    : CRLF;
};

# Headers block
type Headers = unit {
    headers: HeaderField[];
    : CRLF;
};

# Chunked transfer encoding
type Chunk = unit {
    chunk_size: bytes &until=CRLF &convert=$$.to_uint(16);
    : CRLF;
    chunk_data: bytes &size=self.chunk_size;
    : CRLF;
};

type ChunkedBody = unit {
    chunks: Chunk[] until(self.$$.chunk_size == 0);
    trailer: Headers;
};

# Message body
type MessageBody = unit {
    switch {
        -> chunked: chunked_body: ChunkedBody;
        -> identity: data: bytes &eod;
    };
};

# HTTP request
public type Request = unit {
    request_line: RequestLine;
    headers: Headers;
    body: MessageBody if(self.headers.has_content_length || self.headers.has_transfer_encoding);
};

# HTTP response
public type Response = unit {
    status_line: StatusLine;
    headers: Headers;
    body: MessageBody if(self.status_line.status_code != 100 && 
                        self.status_line.status_code != 101 &&
                        self.status_line.status_code != 204 &&
                        self.status_line.status_code != 304 &&
                        !(self.request_line.method == b"HEAD"));
};

# Main HTTP message type
public type HTTPMessage = unit {
    switch {
        -> request: Request;
        -> response: Response;
    };
};

# Common header field values
const content_coding = /gzip|compress|deflate|identity/;
const transfer_coding = /chunked|identity|gzip|compress|deflate/;
const media_type = token b"/" token;
const language_tag = /[a-zA-Z]{1,8}(-[a-zA-Z0-9]{1,8})*/;
const qvalue = /0(\.[0-9]{0,3})?|1(\.[0]{0,3})?/;
const etag = /[Ww]\/".*"|".*"/;
const range_unit = /bytes|none/;

# Method enum
type Method = enum {
    OPTIONS = 1,
    GET = 2,
    HEAD = 3,
    POST = 4,
    PUT = 5,
    DELETE = 6,
    TRACE = 7,
    CONNECT = 8,
};

# Status code enum
type StatusCode = enum {
    Continue = 100,
    SwitchingProtocols = 101,
    OK = 200,
    Created = 201,
    Accepted = 202,
    NonAuthoritativeInformation = 203,
    NoContent = 204,
    ResetContent = 205,
    PartialContent = 206,
    MultipleChoices = 300,
    MovedPermanently = 301,
    Found = 302,
    SeeOther = 303,
    NotModified = 304,
    UseProxy = 305,
    TemporaryRedirect = 307,
    BadRequest = 400,
    Unauthorized = 401,
    PaymentRequired = 402,
    Forbidden = 403,
    NotFound = 404,
    MethodNotAllowed = 405,
    NotAcceptable = 406,
    ProxyAuthenticationRequired = 407,
    RequestTimeout = 408,
    Conflict = 409,
    Gone = 410,
    LengthRequired = 411,
    PreconditionFailed = 412,
    RequestEntityTooLarge = 413,
    RequestURITooLong = 414,
    UnsupportedMediaType = 415,
    RequestedRangeNotSatisfiable = 416,
    ExpectationFailed = 417,
    InternalServerError = 500,
    NotImplemented = 501,
    BadGateway = 502,
    ServiceUnavailable = 503,
    GatewayTimeout = 504,
    HTTPVersionNotSupported = 505,
};

# Cache control directives
const cache_directive = token (b"=" (token | quoted_string))?;

# Quality value parameter
type QValueParam = unit {
    : b";q=";
    qvalue: qvalue &convert=$$.to_double();
};

# Media range with quality
type MediaRange = unit {
    type_value: token;
    : b"/";
    subtype: token;
    params: (b";" token b"=" (token | quoted_string))*;
    qparam: QValueParam?;
};

# Byte range specifier
type ByteRangeSpec = unit {
    first_byte: uint64?;
    : b"-";
    last_byte: uint64?;
};

# Content range
type ContentRange = unit {
    : b"bytes ";
    first_byte: uint64;
    : b"-";
    last_byte: uint64;
    : b"/";
    instance_length: (uint64 | b"*");
};

# Warning header
type Warning = unit {
    warn_code: uint16;
    : SP;
    warn_agent: bytes &until=SP;
    : SP;
    warn_text: quoted_string;
    warn_date: (SP quoted_string)?;
};

# Via header
type Via = unit {
    protocol_name: token?;
    : b"/";
    protocol_version: token;
    : SP;
    received_by: (host: bytes &until=SP; port: (b":" uint16)?);
    comment: (SP comment)?;
};