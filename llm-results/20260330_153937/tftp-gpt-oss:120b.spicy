module TFTP;

type Opcode = enum {
  RRQ = 1,
  WRQ = 2,
  DATA = 3,
  ACK = 4,
  ERROR = 5,
};

type ErrorCode = enum {
  NotDefined = 0,
  FileNotFound = 1,
  AccessViolation = 2,
  DiskFull = 3,
  IllegalOperation = 4,
  UnknownTID = 5,
  FileExists = 6,
  NoUser = 7,
};

public type TftpPacket = unit {
  opcode: uint16 &convert=Opcode($$);
  switch (self.opcode) {
    Opcode::RRQ, Opcode::WRQ -> {
        filename: bytes &until=b"\0";
        mode: bytes &until=b"\0";
    };
    Opcode::DATA -> {
        block: uint16;
        data: bytes &eod;
    };
    Opcode::ACK -> {
        block: uint16;
    };
    Opcode::ERROR -> {
        errcode: uint16 &convert=ErrorCode($$);
        errmsg: bytes &until=b"\0";
    };
    * -> { }
  };
};