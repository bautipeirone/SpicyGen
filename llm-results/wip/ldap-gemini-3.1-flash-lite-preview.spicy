module LDAP;

type MessageID = int32;

type LDAPString = unit { s: bytes &until=b""; };
type LDAPOID = unit { s: bytes &until=b""; };
type LDAPDN = LDAPString;
type RelativeLDAPDN = LDAPString;
type AttributeDescription = LDAPString;
type AttributeValue = unit { v: bytes &eod; };
type AssertionValue = unit { v: bytes &eod; };

type AttributeValueAssertion = unit {
    attributeDesc: AttributeDescription;
    assertionValue: AssertionValue;
};

type PartialAttribute = unit {
    type: AttributeDescription;
    vals: AttributeValue[];
};

type Attribute = PartialAttribute;

type ResultCode = enum {
    success = 0,
    operationsError = 1,
    protocolError = 2,
    timeLimitExceeded = 3,
    sizeLimitExceeded = 4,
    compareFalse = 5,
    compareTrue = 6,
    authMethodNotSupported = 7,
    strongerAuthRequired = 8,
    referral = 10,
    adminLimitExceeded = 11,
    unavailableCriticalExtension = 12,
    confidentialityRequired = 13,
    saslBindInProgress = 14,
    noSuchAttribute = 16,
    undefinedAttributeType = 17,
    inappropriateMatching = 18,
    constraintViolation = 19,
    attributeOrValueExists = 20,
    invalidAttributeSyntax = 21,
    noSuchObject = 32,
    aliasProblem = 33,
    invalidDNSyntax = 34,
    aliasDereferencingProblem = 36,
    inappropriateAuthentication = 48,
    invalidCredentials = 49,
    insufficientAccessRights = 50,
    busy = 51,
    unavailable = 52,
    unwillingToPerform = 53,
    loopDetect = 54,
    namingViolation = 64,
    objectClassViolation = 65,
    notAllowedOnNonLeaf = 66,
    notAllowedOnRDN = 67,
    entryAlreadyExists = 68,
    objectClassModsProhibited = 69,
    affectsMultipleDSAs = 71,
    other = 80
};

type URI = LDAPString;

type LDAPResult = unit {
    resultCode: uint8 &convert=ResultCode($$);
    matchedDN: LDAPDN;
    diagnosticMessage: LDAPString;
    referral: URI[] &optional;
};

type Control = unit {
    controlType: LDAPOID;
    criticality: bool &default=False;
    controlValue: bytes &eod &optional;
};

type SaslCredentials = unit {
    mechanism: LDAPString;
    credentials: bytes &eod &optional;
};

type AuthenticationChoice = unit {
    switch {
        -> simple: bytes &eod;
        -> sasl: SaslCredentials;
    };
};

type BindRequest = unit {
    version: int8;
    name: LDAPDN;
    authentication: AuthenticationChoice;
};

type BindResponse = unit {
    result: LDAPResult;
    serverSaslCreds: bytes &eod &optional;
};

type Filter = unit {
    choice: uint8;
};

type SearchRequest = unit {
    baseObject: LDAPDN;
    scope: uint8;
    derefAliases: uint8;
    sizeLimit: int32;
    timeLimit: int32;
    typesOnly: bool;
    filter: Filter;
    attributes: LDAPString[];
};

type SearchResultEntry = unit {
    objectName: LDAPDN;
    attributes: PartialAttribute[];
};

type ModifyRequest = unit {
    object: LDAPDN;
    changes: unit {
        operation: uint8;
        modification: PartialAttribute;
    }[];
};

type AddRequest = unit {
    entry: LDAPDN;
    attributes: Attribute[];
};

type ModifyDNRequest = unit {
    entry: LDAPDN;
    newrdn: RelativeLDAPDN;
    deleteoldrdn: bool;
    newSuperior: LDAPDN &optional;
};

type CompareRequest = unit {
    entry: LDAPDN;
    ava: AttributeValueAssertion;
};

type ExtendedRequest = unit {
    requestName: LDAPOID;
    requestValue: bytes &eod &optional;
};

type ExtendedResponse = unit {
    result: LDAPResult;
    responseName: LDAPOID &optional;
    responseValue: bytes &eod &optional;
};

type IntermediateResponse = unit {
    responseName: LDAPOID &optional;
    responseValue: bytes &eod &optional;
};

public type LDAPMessage = unit {
    messageID: MessageID;
    protocolOp: unit {
        switch {
            -> bindRequest: BindRequest;
            -> bindResponse: BindResponse;
            -> unbindRequest: void;
            -> searchRequest: SearchRequest;
            -> searchResEntry: SearchResultEntry;
            -> searchResDone: LDAPResult;
            -> searchResRef: URI[];
            -> modifyRequest: ModifyRequest;
            -> modifyResponse: LDAPResult;
            -> addRequest: AddRequest;
            -> addResponse: LDAPResult;
            -> delRequest: LDAPDN;
            -> delResponse: LDAPResult;
            -> modDNRequest: ModifyDNRequest;
            -> modDNResponse: LDAPResult;
            -> compareRequest: CompareRequest;
            -> compareResponse: LDAPResult;
            -> abandonRequest: MessageID;
            -> extendedReq: ExtendedRequest;
            -> extendedResp: ExtendedResponse;
            -> intermediateResponse: IntermediateResponse;
        };
    };
    controls: Control[] &optional;
};