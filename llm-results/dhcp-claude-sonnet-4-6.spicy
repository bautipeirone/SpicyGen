module DHCP;

type MessageOp = enum {
    BOOTREQUEST = 1,
    BOOTREPLY   = 2,
};

type MessageType = enum {
    DHCPDISCOVER = 1,
    DHCPOFFER    = 2,
    DHCPREQUEST  = 3,
    DHCPDECLINE  = 4,
    DHCPACK      = 5,
    DHCPNAK      = 6,
    DHCPRELEASE  = 7,
    DHCPINFORM   = 8,
};

type OptionCode = enum {
    PAD                  = 0,
    SUBNET_MASK          = 1,
    ROUTER               = 3,
    DNS                  = 6,
    HOSTNAME             = 12,
    REQUESTED_IP         = 50,
    LEASE_TIME           = 51,
    OPTION_OVERLOAD      = 52,
    DHCP_MSG_TYPE        = 53,
    SERVER_IDENTIFIER    = 54,
    PARAM_REQUEST_LIST   = 55,
    MESSAGE              = 56,
    MAX_MSG_SIZE         = 57,
    RENEWAL_T1           = 58,
    REBINDING_T2         = 59,
    VENDOR_CLASS_ID      = 60,
    CLIENT_IDENTIFIER    = 61,
    END                  = 255,
};

# Magic cookie: 99.130.83.99
const MAGIC_COOKIE = b"\x63\x82\x53\x63";

type Flags = unit {
    f: bitfield(16) {
        broadcast: 15;
        mbz:       0..14;
    };
};

type Option = unit {
    code: uint8 &convert=OptionCode($$);
    switch ( self.code ) {
        OptionCode::PAD -> : void;
        OptionCode::END -> : void;
        * -> {
            length: uint8;
            switch ( self.code ) {
                OptionCode::DHCP_MSG_TYPE      -> msg_type:        uint8 &convert=MessageType($$);
                OptionCode::SUBNET_MASK        -> subnet_mask:     addr &ipv4;
                OptionCode::ROUTER             -> routers:         (addr &ipv4)[self.length / 4];
                OptionCode::DNS                -> dns_servers:     (addr &ipv4)[self.length / 4];
                OptionCode::REQUESTED_IP       -> requested_ip:    addr &ipv4;
                OptionCode::LEASE_TIME         -> lease_time:      uint32 &convert=cast<interval>($$);
                OptionCode::OPTION_OVERLOAD    -> overload:        uint8;
                OptionCode::SERVER_IDENTIFIER  -> server_id:       addr &ipv4;
                OptionCode::PARAM_REQUEST_LIST -> param_list:      bytes &size=self.length;
                OptionCode::MESSAGE            -> message:         bytes &size=self.length &convert=$$.decode();
                OptionCode::MAX_MSG_SIZE       -> max_msg_size:    uint16;
                OptionCode::RENEWAL_T1         -> renewal_t1:      uint32 &convert=cast<interval>($$);
                OptionCode::REBINDING_T2       -> rebinding_t2:    uint32 &convert=cast<interval>($$);
                OptionCode::VENDOR_CLASS_ID    -> vendor_class_id: bytes &size=self.length &convert=$$.decode();
                OptionCode::CLIENT_IDENTIFIER  -> client_id:       bytes &size=self.length;
                OptionCode::HOSTNAME           -> hostname:        bytes &size=self.length &convert=$$.decode();
                *                              -> data:            bytes &size=self.length;
            };
        }
    };
};

type Options = unit {
    : MAGIC_COOKIE;
    options: Option[] &eod;
};

public type DHCPMessage = unit {
    op:     uint8  &convert=MessageOp($$);
    htype:  uint8;
    hlen:   uint8  &requires=($$ <= 16);
    hops:   uint8;
    xid:    uint32;
    secs:   uint16;
    flags:  Flags;
    ciaddr: addr   &ipv4;
    yiaddr: addr   &ipv4;
    siaddr: addr   &ipv4;
    giaddr: addr   &ipv4;
    chaddr: bytes  &size=16;
    sname:  bytes  &size=64  &convert=$$.split1(b"\x00")[0].decode();
    file:   bytes  &size=128 &convert=$$.split1(b"\x00")[0].decode();
    options: Options;
};