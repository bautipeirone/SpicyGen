module DNS;

import spicy;

# DNS opcodes
type Opcode = enum {
    QUERY = 0,
    IQUERY = 1,
    STATUS = 2
};

# DNS response codes
type RCode = enum {
    NOERROR = 0,
    FORMERR = 1,
    SERVFAIL = 2,
    NXDOMAIN = 3,
    NOTIMP = 4,
    REFUSED = 5
};

# RR Types
type Type = enum {
    A = 1,
    NS = 2,
    MD = 3,
    MF = 4,
    CNAME = 5,
    SOA = 6,
    MB = 7,
    MG = 8,
    MR = 9,
    NULL = 10,
    WKS = 11,
    PTR = 12,
    HINFO = 13,
    MINFO = 14,
    MX = 15,
    TXT = 16,
    AXFR = 252,
    MAILB = 253,
    MAILA = 254,
    ANY = 255
};

# RR Classes
type Class = enum {
    IN = 1,
    CS = 2,
    CH = 3,
    HS = 4
};

# DNS Header
public type Header = unit {
    id: uint16;
    flags: bitfield(16) {
        qr: 0;
        opcode: 1..4;
        aa: 5;
        tc: 6;
        rd: 7;
        ra: 8;
        z: 9..11;
        rcode: 12..15;
    } &bit-order=spicy::BitOrder::MSB0;
    qdcount: uint16;
    ancount: uint16;
    nscount: uint16;
    arcount: uint16;
};

# Domain name - simplified version for now
type DomainName = unit {
    data: bytes &until=b"\0";
    : uint8;
};

# Question section
type Question = unit {
    qname: DomainName;
    qtype: uint16 &convert=Type($$);
    qclass: uint16 &convert=Class($$);
};

# Resource Record
type RR = unit {
    name: DomainName;
    type_value: uint16 &convert=Type($$);
    class_value: uint16 &convert=Class($$);
    ttl: uint32;
    rdlength: uint16;
    rdata: bytes &size=self.rdlength;
};

# DNS Message
public type Message = unit {
    header: Header;
    questions: Question[self.header.qdcount];
    answers: RR[self.header.ancount];
    authorities: RR[self.header.nscount];
    additionals: RR[self.header.arcount];
};