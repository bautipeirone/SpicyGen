module TFTPProto;
    # Opcode enumeration
    type Opcode = enum {
        RRQ = 1,
        WRQ = 2,
        DATA = 3,
        ACK = 4,
        ERROR = 5,
    };

    # Error code enumeration
    type ErrorCode = enum {
        NotDefined = 0,
        FileNotFound = 1,
        AccessViolation = 2,
        DiskFull = 3,
        IllegalOperation = 4,
        UnknownTID = 5,
        FileExists = 6,
        NoSuchUser = 7,
    };

    # RRQ and WRQ share the same format after the opcode
    type RRQ_WRQ = unit {
        filename: bytes &until=b"\0" &convert=$$.decode();
        : b"\0"; # null terminator
        mode: bytes &until=b"\0" &convert=$$.decode();
        : b"\0"; # null terminator
    };

    # DATA packet
    type Data = unit {
        block: uint16;
        data: bytes &eod;
    };

    # ACK packet
    type Ack = unit {
        block: uint16;
    };

    # ERROR packet
    type Error = unit {
        errcode: uint16 &convert=ErrorCode($$);
        errmsg: bytes &until=b"\0" &convert=$$.decode();
        : b"\0"; # null terminator
    };

    # Main TFTP packet parser
    public type TFTP = unit {
        opcode: uint16 &convert=Opcode($$);
        switch (self.opcode) {
            Opcode::RRQ,
            Opcode::WRQ -> request: RRQ_WRQ;
            Opcode::DATA -> data: Data;
            Opcode::ACK -> ack: Ack;
            Opcode::ERROR -> error: Error;
            * -> : void;
        };
    };