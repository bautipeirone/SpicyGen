module dhcp;

# DHCP Message Types
public type MessageType = unit {
    type: uint8;
    switch (self.type) {
        1 -> name: b"DHCPDISCOVER";
        2 -> name: b"DHCPOFFER";
        3 -> name: b"DHCPREQUEST";
        4 -> name: b"DHCPACK";
        5 -> name: b"DHCPNAK";
        6 -> name: b"DHCPDECLINE";
        7 -> name: b"DHCPRELEASE";
        8 -> name: b"DHCPINFORM";
        * -> name: b"UNKNOWN";
    };
};

# Flags field structure (Figure 2)
public type FlagsField = unit {
    f: bitfield(16) {
        broadcast: 0;
        reserved: 1..15;
    };
};

# DHCP Options Magic Cookie
public type MagicCookie = unit {
    cookie: bytes &size=4 &requires=($$ == b"\x63\x82\x53\x63");
};

# Individual DHCP Option
public type DHCPOption = unit {
    code: uint8;
    switch (self.code) {
        0 -> pad: uint8;
        255 -> end: uint8;
        1 -> subnet_mask: bytes &size=4;
        2 -> time_offset: int32;
        3 -> router: bytes[] &size=4;
        4 -> time_server: bytes[];
        5 -> name_server: bytes[];
        6 -> domain_server: bytes[];
        7 -> log_server: bytes[];
        8 -> quote_server: bytes[];
        9 -> lpr_server: bytes[];
        12 -> host_name: bytes &eod;
        14 -> dump_path: bytes &eod;
        15 -> domain_name: bytes &eod;
        22 -> max_dgram_size: uint16;
        23 -> ip_ttl: uint8;
        28 -> broadcast_address: bytes &size=4;
        29 -> mask_discovery: uint8;
        30 -> mask_supplier: uint8;
        31 -> router_discovery: uint8;
        32 -> router_solication: bytes &size=4;
        33 -> static_route: bytes[];
        42 -> ntp_server: bytes[];
        43 -> vendor_specific: bytes &eod;
        44 -> netbios_ns: bytes[];
        45 -> netbios_dd: bytes[];
        46 -> netbios_node: uint8;
        47 -> netbios_scope: bytes &eod;
        48 -> x_window_fs: bytes[];
        49 -> x_window_dm: bytes[];
        50 -> requested_ip: bytes &size=4;
        51 -> lease_time: uint32;
        52 -> option_overload: uint8;
        53 -> message_type: MessageType;
        54 -> server_identifier: bytes &size=4;
        55 -> parameter_request_list: uint8[];
        56 -> message: bytes &eod;
        57 -> max_message_size: uint16;
        58 -> renewal_time: uint32;
        59 -> rebinding_time: uint32;
        60 -> vendor_class_identifier: bytes &eod;
        61 -> client_identifier: bytes &eod;
        * -> generic: {
            len: uint8;
            data: bytes &size=self.len;
        };
    };
};

# DHCP Options Field with magic cookie
public type DHCPOptions = unit {
    magic: MagicCookie;
    options: DHCPOption[] &eod;
};

# Main DHCP Message Structure (Figure 1)
public type DHCPMessage = unit {
    op: uint8 &requires=($$ == 1 || $$ == 2);  # 1=BOOTREQUEST, 2=BOOTREPLY
    htype: uint8;
    hlen: uint8;
    hops: uint8;
    xid: uint32;
    secs: uint16;
    flags: FlagsField;
    ciaddr: uint32;
    yiaddr: uint32;
    siaddr: uint32;
    giaddr: uint32;
    chaddr: bytes &size=16;
    sname: bytes &size=64;
    file: bytes &size=128;
    options: DHCPOptions;
};

# DHCP Message Type Constraints
public type DHCPDiscover = unit {
    msg: DHCPMessage &requires=(msg.op == 1);
    msg_type: MessageType &requires=(msg_type.type == 1);
};

public type DHCPOffer = unit {
    msg: DHCPMessage &requires=(msg.op == 2);
    msg_type: MessageType &requires=(msg_type.type == 2);
};

public type DHCPRequest = unit {
    msg: DHCPMessage &requires=(msg.op == 1);
    msg_type: MessageType &requires=(msg_type.type == 3);
};

public type DHCPAck = unit {
    msg: DHCPMessage &requires=(msg.op == 2);
    msg_type: MessageType &requires=(msg_type.type == 4);
};

public type DHCPNak = unit {
    msg: DHCPMessage &requires=(msg.op == 2);
    msg_type: MessageType &requires=(msg_type.type == 5);
};

public type DHCPDecline = unit {
    msg: DHCPMessage &requires=(msg.op == 1);
    msg_type: MessageType &requires=(msg_type.type == 6);
};

public type DHCPRelease = unit {
    msg: DHCPMessage &requires=(msg.op == 1);
    msg_type: MessageType &requires=(msg_type.type == 7);
};

public type DHCPInform = unit {
    msg: DHCPMessage &requires=(msg.op == 1);
    msg_type: MessageType &requires=(msg_type.type == 8);
};

# Client State-Based Message Constraints (Table 4)
public type ClientMessageInitReboot = unit {
    msg: DHCPRequest;
    msg.msg.flags.f.broadcast == 1;
    msg.msg.ciaddr == 0;
    has_requested_ip: bool &requires=(has_option(msg.msg.options, 50));
    has_server_id: bool &requires=(has_option(msg.msg.options, 54) == false);
};

public type ClientMessageSelecting = unit {
    msg: DHCPRequest;
    msg.msg.flags.f.broadcast == 1;
    msg.msg.ciaddr == 0;
    has_requested_ip: bool &requires=(has_option(msg.msg.options, 50));
    has_server_id: bool &requires=(has_option(msg.msg.options, 54));
};

public type ClientMessageRenewing = unit {
    msg: DHCPRequest;
    msg.msg.flags.f.broadcast == 0;
    msg.msg.ciaddr != 0;
    has_requested_ip: bool &requires=(has_option(msg.msg.options, 50) == false);
    has_server_id: bool &requires=(has_option(msg.msg.options, 54) == false);
};

public type ClientMessageRebinding = unit {
    msg: DHCPRequest;
    msg.msg.flags.f.broadcast == 1;
    msg.msg.ciaddr != 0;
    has_requested_ip: bool &requires=(has_option(msg.msg.options, 50) == false);
    has_server_id: bool &requires=(has_option(msg.msg.options, 54) == false);
};

# Server Response Constraints (Table 3)
public type ServerOffer = unit {
    msg: DHCPOffer;
    msg.msg.hops == 0;
    msg.msg.secs == 0;
    msg.msg.ciaddr == 0;
    msg.msg.yiaddr != 0;
    has_lease_time: bool &requires=(has_option(msg.msg.options, 51));
    has_server_id: bool &requires=(has_option(msg.msg.options, 54));
    has_msg_type: bool &requires=(get_option_type(msg.msg.options) == 2);
};

public type ServerAck = unit {
    msg: DHCPAck;
    msg.msg.hops == 0;
    msg.msg.secs == 0;
    msg.msg.yiaddr != 0;
    has_lease_time: bool &requires=(has_option(msg.msg.options, 51));
    has_server_id: bool &requires=(has_option(msg.msg.options, 54));
    has_msg_type: bool &requires=(get_option_type(msg.msg.options) == 4);
};

public type ServerNak = unit {
    msg: DHCPNak;
    msg.msg.hops == 0;
    msg.msg.secs == 0;
    msg.msg.yiaddr == 0;
    msg.msg.ciaddr == 0;
    has_server_id: bool &requires=(has_option(msg.msg.options, 54));
    has_msg_type: bool &requires=(get_option_type(msg.msg.options) == 5);
};

# Lease Time Constants
public type LeaseTime = unit {
    time: uint32;
    is_infinity: bool &requires=(time == 0xffffffff);
};

# UDP Ports
public type DHCPPorts = unit {
    server_port: uint16 &requires=($$ == 67);
    client_port: uint16 &requires=($$ == 68);
};
