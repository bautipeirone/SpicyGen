module DHCP;

const MagicCookie = b"\x63\x82\x53\x63";

public type DHCPMessage = unit {
    op: uint8 &convert=Opcode($$);
    htype: uint8;
    hlen: uint8;
    hops: uint8;
    xid: uint32;
    secs: uint16;
    flags: uint16;
    ciaddr: addr &ipv4;
    yiaddr: addr &ipv4;
    siaddr: addr &ipv4;
    giaddr: addr &ipv4;
    chaddr: bytes &size=16;
    sname: bytes &size=64 &convert=$$.split1(b"\0")[0].decode();
    filename: bytes &size=128 &convert=$$.split1(b"\0")[0].decode();
    options: bytes &size=312 &eod;
};

type Opcode = enum {
    BOOTREQUEST = 1,
    BOOTREPLY = 2,
};

public type DHCPDiscover = unit {
    message: DHCPMessage;
    switch (self.message.options) {
        MagicCookie -> : void; # Must include magic cookie
        * -> : void; # Other options
    };
};

public type DHCPOffer = unit {
    message: DHCPMessage;
    switch (self.message.options) {
        MagicCookie -> : void; # Must include magic cookie
        * -> : void; # Other options
    };
};

public type DHCPRequest = unit {
    message: DHCPMessage;
    switch (self.message.options) {
        MagicCookie -> : void; # Must include magic cookie
        * -> : void; # Other options
    };
};

public type DHCPAck = unit {
    message: DHCPMessage;
    switch (self.message.options) {
        MagicCookie -> : void; # Must include magic cookie
        * -> : void; # Other options
    };
};

public type DHCPNak = unit {
    message: DHCPMessage;
    switch (self.message.options) {
        MagicCookie -> : void; # Must include magic cookie
        * -> : void; # Other options
    };
};

public type DHCPDecline = unit {
    message: DHCPMessage;
    switch (self.message.options) {
        MagicCookie -> : void; # Must include magic cookie
        * -> : void; # Other options
    };
};

public type DHCPRelease = unit {
    message: DHCPMessage;
    switch (self.message.options) {
        MagicCookie -> : void; # Must include magic cookie
        * -> : void; # Other options
    };
};

public type DHCPInform = unit {
    message: DHCPMessage;
    switch (self.message.options) {
        MagicCookie -> : void; # Must include magic cookie
        * -> : void; # Other options
    };
};