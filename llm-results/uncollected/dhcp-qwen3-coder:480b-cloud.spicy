module DHCP;

public type MessageType = enum {
    DHCPDISCOVER = 1,
    DHCPOFFER = 2,
    DHCPREQUEST = 3,
    DHCPDECLINE = 4,
    DHCPACK = 5,
    DHCPNAK = 6,
    DHCPRELEASE = 7,
    DHCPINFORM = 8,
};

type Opcode = enum {
    BOOTREQUEST = 1,
    BOOTREPLY = 2,
};

public type Packet = unit {
    op: uint8 &convert=Opcode($$);
    htype: uint8;
    hlen: uint8;
    hops: uint8;
    xid: uint32;
    secs: uint16;
    flags: uint16;
    ciaddr: addr &ipv4;
    yiaddr: addr &ipv4;
    siaddr: addr &ipv4;
    giaddr: addr &ipv4;
    chaddr: bytes &size=16;
    sname: bytes &size=64 &convert=$$.split1(b"\0")[0].decode();
    filename: bytes &size=128 &convert=$$.split1(b"\0")[0].decode();
    magic: uint32 &requires=($$ == 0x63825363);
    options: Option[];
};

type Option = unit {
    code: uint8;
    len: uint8;
    data: bytes &size=self.len;
};