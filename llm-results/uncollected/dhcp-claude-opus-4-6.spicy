module DHCP;

# DHCP Message Types
type MessageType = enum {
    DHCPDISCOVER = 1,
    DHCPOFFER = 2,
    DHCPREQUEST = 3,
    DHCPDECLINE = 4,
    DHCPACK = 5,
    DHCPNAK = 6,
    DHCPRELEASE = 7,
    DHCPINFORM = 8,
};

# Op code
type OpCode = enum {
    BOOTREQUEST = 1,
    BOOTREPLY = 2,
};

# DHCP Option
type DHCPOption = unit {
    code: uint8;
    switch ( self.code ) {
        0 -> : void;    # Pad option, no length or data
        255 -> : void;  # End option, no length or data
        * -> {
            len: uint8;
            data: bytes &size=self.len;
        }
    };
};

# Options field: magic cookie followed by list of options terminated by end option (255)
type DHCPOptions = unit {
    # Magic cookie: 99.130.83.99
    magic_cookie: bytes &size=4 &requires=($$ == b"\x63\x82\x53\x63");
    options: DHCPOption[];
};

# Flags bitfield
type Flags = unit {
    f: bitfield(16) {
        broadcast: 15;
        mbz: 0..14;
    };
};

# Main DHCP Message
public type DHCPMessage = unit {
    op: uint8 &convert=OpCode($$);
    htype: uint8;
    hlen: uint8;
    hops: uint8;
    xid: uint32;
    secs: uint16;
    flags: Flags;
    ciaddr: addr &ipv4;
    yiaddr: addr &ipv4;
    siaddr: addr &ipv4;
    giaddr: addr &ipv4;
    chaddr: bytes &size=16;
    sname: bytes &size=64 &convert=$$.split1(b"\0")[0].decode();
    filename: bytes &size=128 &convert=$$.split1(b"\0")[0].decode();
    options: DHCPOptions;
};