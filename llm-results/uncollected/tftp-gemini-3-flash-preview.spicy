module TFTP;

# TFTP Opcode enumeration based on RFC 1350
type Opcode = enum {
    RRQ   = 1,
    WRQ   = 2,
    DATA  = 3,
    ACK   = 4,
    ERROR = 5,
};

# TFTP Error Codes enumeration
type ErrorCode = enum {
    NOT_DEFINED        = 0,
    FILE_NOT_FOUND     = 1,
    ACCESS_VIOLATION   = 2,
    DISK_FULL          = 3,
    ILLEGAL_OPERATION  = 4,
    UNKNOWN_TID        = 5,
    FILE_EXISTS        = 6,
    NO_SUCH_USER       = 7,
};

# Main TFTP Packet structure
public type Packet = unit {
    opcode: uint16 &convert=Opcode($$);

    switch ( self.opcode ) {
        Opcode::RRQ, 
        Opcode::WRQ   -> request:  RRQ_WRQ;
        Opcode::DATA  -> data_pkt: DATA_Pkt;
        Opcode::ACK   -> ack_pkt:  ACK_Pkt;
        Opcode::ERROR -> error_pkt: ERROR_Pkt;
        *             -> unknown:  bytes &eod;
    };
};

# Format for Read Request (RRQ) and Write Request (WRQ)
type RRQ_WRQ = unit {
    # Filename is a netascii string, terminated by a null byte
    filename: bytes &until=b"\0";
    
    # Mode is a netascii string (netascii, octet, or mail), case insensitive, null terminated
    mode:     bytes &until=b"\0";
};

# Format for DATA packets
type DATA_Pkt = unit {
    # Block number is a 2-byte field increasing by one for each new block
    block: uint16;
    
    # Data is 0 to 512 bytes long. 
    # A block less than 512 bytes signals the end of the transfer.
    # Since TFTP packets are encapsulated in UDP, we consume the rest of the available payload.
    data:  bytes &eod &size=512;
};

# Format for Acknowledgment (ACK) packets
type ACK_Pkt = unit {
    # Block number of the DATA packet being acknowledged
    # or 0 for a WRQ acknowledgment.
    block: uint16;
};

# Format for ERROR packets
type ERROR_Pkt = unit {
    # Error code indicating the nature of the error
    error_code_value: uint16 &convert=ErrorCode($$);
    
    # Error message intended for human consumption, null terminated
    error_msg:        bytes &until=b"\0";
};