module rfc2616;

# 2.2 Basic Rules
const Token = /[a-zA-Z0-9!#$%&'*+.\^_`|~-]+/;
const SP = b" ";
const CRLF = b"\r\n";

# 3.1 HTTP Version
type HttpVersion = unit {
    : b"HTTP/";
    major_version: /[0-9]+/ &convert=$$.to_uint();
    : b".";
    minor_version: /[0-9]+/ &convert=$$.to_uint();
};

# 5.1 Request-Line
type RequestLine = unit {
    method_val: Token &convert=$$.decode();
    : SP;
    uri_val: /[^\s]+/ &convert=$$.decode();
    : SP;
    version: HttpVersion;
    : CRLF;
};

# 6.1 Status-Line
type StatusLine = unit {
    version: HttpVersion;
    : SP;
    status_code_val: /[0-9]{3}/ &convert=$$.to_uint();
    : SP;
    reason_phrase_val: /[^\r\n]*/ &convert=$$.decode();
    : CRLF;
};

# 4.2 Message Headers
type MessageHeader = unit {
    h_name: Token &convert=$$.decode();
    : b":";
    : /[ \t]*/;
    h_value: /[^\r\n]*(\r\n[ \t]+[^\r\n]*)*/ &convert=$$.decode();
    : CRLF;
};

# 5 Request
type Request = unit {
    start_line: RequestLine;
    msg_headers: MessageHeader[];
    : CRLF;
    msg_body: bytes &eod;
};

# 6 Response
type Response = unit {
    start_line: StatusLine;
    msg_headers: MessageHeader[];
    : CRLF;
    msg_body: bytes &eod;
};

# 4.1 Message Types
# The switch uses look-ahead to distinguish between Request and Response.
# Response starts with "HTTP/", while Request starts with a Method (Token).
# Since "/" is a separator, a Token cannot contain it, making "HTTP/" unique to Response.
public type HttpMessage = unit {
    switch {
        -> res: Response;
        -> req: Request;
    };
};