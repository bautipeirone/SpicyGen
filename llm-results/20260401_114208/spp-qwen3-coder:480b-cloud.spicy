module CCSDS;

public type SpacePacket = unit {
    primaryHeader: PacketPrimaryHeader;
    dataField: PacketDataField &size=(self.primaryHeader.packetDataLength + 1);
};

type PacketPrimaryHeader = unit {
    # Bits 0-2: Packet Version Number (3 bits)
    # Bits 3-15: Packet Identification Field (13 bits)
    versionAndId: bitfield(16) {
        packetVersionNumber: 0..2;  # Should be 000 for CCSDS Space Packet
        packetType: 3..3;           # 0=telemetry, 1=telecommand
        secondaryHeaderFlag: 4..4;  # 1=secondary header present, 0=not present
        apid: 5..15;                # Application Process Identifier
    };
    
    # Bits 16-31: Packet Sequence Control Field (16 bits)
    sequenceControl: bitfield(16) {
        sequenceFlags: 0..1;        # 00=continuation, 01=first, 10=last, 11=unsegmented
        packetSequenceCount: 2..15; # Packet sequence count or name
    };
    
    # Bits 32-47: Packet Data Length (16 bits)
    packetDataLength: uint16;       # Length of data field - 1
};

type PacketDataField = unit {
    # Check if secondary header is present based on flag in primary header
    # We'll handle this with conditional parsing in the parent unit
    data: bytes &eod;
};