module BFD;

type DiagnosticCode = enum {
    NoDiagnostic = 0,
    ControlDetectionTimeExpired = 1,
    EchoFunctionFailed = 2,
    NeighborSignaledSessionDown = 3,
    ForwardingPlaneReset = 4,
    PathDown = 5,
    ConcatenatedPathDown = 6,
    AdministrativelyDown = 7,
    ReverseConcatenatedPathDown = 8,
};

type State = enum {
    AdminDown = 0,
    Down = 1,
    Init = 2,
    Up = 3,
};

type AuthType = enum {
    Reserved = 0,
    SimplePassword = 1,
    KeyedMD5 = 2,
    MeticulousKeyedMD5 = 3,
    KeyedSHA1 = 4,
    MeticulousKeyedSHA1 = 5,
};

type SimplePasswordAuth = unit {
    auth_type: uint8 &convert=AuthType($$);
    auth_len: uint8;
    auth_key_id: uint8;
    password: bytes &size=self.auth_len - 3;
};

type KeyedMD5Auth = unit {
    auth_type: uint8 &convert=AuthType($$);
    auth_len: uint8 &requires=($$ == 24);
    auth_key_id: uint8;
    reserved: uint8 &requires=($$ == 0);
    sequence_number: uint32;
    auth_key_digest: bytes &size=16;
};

type KeyedSHA1Auth = unit {
    auth_type: uint8 &convert=AuthType($$);
    auth_len: uint8 &requires=($$ == 28);
    auth_key_id: uint8;
    reserved: uint8 &requires=($$ == 0);
    sequence_number: uint32;
    auth_key_hash: bytes &size=20;
};

public type BFDControlPacket = unit {
    # First byte: Version and Diagnostic
    version_diag: bitfield(8) {
        version: 0..2 &requires=($$ == 1);  # Must be version 1
        diag: 3..7 &convert=DiagnosticCode($$);
    };
    
    # Second byte: State and flags
    state_flags: bitfield(8) {
        state: 0..1 &convert=State($$);
        poll: 2;
        final: 3;
        control_plane_independent: 4;
        authentication_present: 5;
        demand: 6;
        multipoint: 7 &requires=($$ == 0);  # Must be zero
    };
    
    detect_mult: uint8 &requires=($$ > 0);  # Must be non-zero
    length: uint8;
    
    my_discriminator: uint32 &requires=($$ != 0);  # Must be non-zero
    your_discriminator: uint32;
    desired_min_tx_interval: uint32 &requires=($$ != 0);  # Must be non-zero
    required_min_rx_interval: uint32;
    required_min_echo_rx_interval: uint32;
    
    # Optional Authentication Section - handled separately based on authentication_present flag
    : bytes &size=self.length - 24 if(self.state_flags.authentication_present == 1);
};