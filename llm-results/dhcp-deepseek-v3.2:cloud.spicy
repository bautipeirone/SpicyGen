        case 74 -> : DefaultInternetRelayChatServerOption;
        case 75 -> : StreetTalkServerOption;
        case 76 -> : StreetTalkDirectoryAssistanceServerOption;
        case 77 -> : UserClassOption;
        case 85 -> : NDServersOption;
        case 86 -> : NDSTreeNameOption;
        case 87 -> : NDSContextOption;
        case 88 -> : BCMCSControllerDomainNameListOption;
        case 89 -> : BCMCSControllerIPv4AddressOption;
