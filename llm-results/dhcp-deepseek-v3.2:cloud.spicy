module DHCP;

public type DHCPMessage = unit {
    op: uint8 &convert=Opcode($$);
    htype: uint8 &convert=HardwareType($$);
    hlen: uint8;
    hops: uint8;
    xid: uint32;
    secs: uint16;
    flags: Flags;
    ciaddr: addr &ipv4;
    yiaddr: addr &ipv4;
    siaddr: addr &ipv4;
    giaddr: addr &ipv4;
    chaddr: bytes &size=16;
    sname: bytes &size=64 &convert=$$.split1(b"\0")[0].decode();
    file: bytes &size=128 &convert=$$.split1(b"\0")[0].decode();
    magic_cookie: b"\x63\x82\x53\x63";
    options: DHCPOption[] &until=option_end;
};

type Opcode = enum {
    BOOTREQUEST = 1,
    BOOTREPLY = 2,
};

type HardwareType = enum {
    ETHERNET = 1,
};

type Flags = bitfield(16) {
    broadcast: 0;
    reserved: 1..15;
};

type DHCPOption = unit {
    code: uint8;
    switch (self.code) {
        case 0 -> : Padding;
        case 255 -> : End;
        default -> : OptionData;
    };
};

type Padding = unit {
    : void;
};

type End = unit {
    : void;
};

type OptionData = unit {
    len: uint8;
    data: bytes &size=self.len;
    switch (self.code) {
        case 53 -> : MessageTypeOption;
        case 50 -> : RequestedIPOption;
        case 51 -> : IPAddressLeaseTimeOption;
        case 54 -> : ServerIdentifierOption;
        case 55 -> : ParameterRequestListOption;
        case 57 -> : MaximumMessageSizeOption;
        case 61 -> : ClientIdentifierOption;
        case 12 -> : HostNameOption;
        case 60 -> : VendorClassIdentifierOption;
        case 43 -> : VendorSpecificInformationOption;
        case 82 -> : RelayAgentInformationOption;
        case 1 -> : SubnetMaskOption;
        case 3 -> : RouterOption;
        case 6 -> : DomainNameServerOption;
        case 15 -> : DomainNameOption;
        case 28 -> : BroadcastAddressOption;
        case 42 -> : NetworkTimeProtocolServersOption;
        case 26 -> : InterfaceMTUOption;
        case 2 -> : TimeOffsetOption;
        case 4 -> : TimeServerOption;
        case 5 -> : NameServerOption;
        case 7 -> : LogServerOption;
        case 8 -> : CookieServerOption;
        case 9 -> : LPRServerOption;
        case 10 -> : ImpressServerOption;
        case 11 -> : ResourceLocationServerOption;
        case 13 -> : BootFileSizeOption;
        case 14 -> : MeritDumpFileOption;
        case 16 -> : SwapServerOption;
        case 17 -> : RootPathOption;
        case 18 -> : ExtensionsPathOption;
        case 19 -> : IPForwardingOption;
        case 20 -> : NonLocalSourceRoutingOption;
        case 21 -> : PolicyFilterOption;
        case 22 -> : MaximumDatagramReassemblySizeOption;
        case 23 -> : DefaultIPTTLOption;
        case 24 -> : PathMTUAgingTimeoutOption;
        case 25 -> : PathMTUPlateauTableOption;
        case 27 -> : AllSubnetsLocalOption;
        case 29 -> : PerformMaskDiscoveryOption;
        case 30 -> : MaskSupplierOption;
        case 31 -> : PerformRouterDiscoveryOption;
        case 32 -> : RouterSolicitationAddressOption;
        case 33 -> : StaticRouteOption;
        case 34 -> : TrailerEncapsulationOption;
        case 35 -> : ARPCacheTimeoutOption;
        case 36 -> : EthernetEncapsulationOption;
        case 37 -> : TCPDefaultTTLOption;
        case 38 -> : TCPKeepaliveIntervalOption;
        case 39 -> : TCPKeepaliveGarbageOption;
        case 40 -> : NetworkInformationServiceDomainOption;
        case 41 -> : NetworkInformationServersOption;
        case 44 -> : NetBIOSOverTCPIPNameServerOption;
        case 45 -> : NetBIOSOverTCPIPDatagramDistributionServerOption;
        case 46 -> : NetBIOSOverTCPIPNodeTypeOption;
        case 47 -> : NetBIOSOverTCPIPScopeOption;
        case 48 -> : XWindowSystemFontServerOption;
        case 49 -> : XWindowSystemDisplayManagerOption;
        case 56 -> : DHCPMessageOption;
