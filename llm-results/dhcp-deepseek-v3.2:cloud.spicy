type MessageTypeOption = unit {
    type_value: uint8 &convert=DHCPMessageType($$);
};

type DHCPMessageType = enum {
    DHCPDISCOVER = 1,
    DHCPOFFER = 2,
    DHCPREQUEST = 3,
    DHCPDECLINE = 4,
    DHCPACK = 5,
    DHCPNAK = 6,
    DHCPRELEASE = 7,
    DHCPINFORM = 8,
};

type RequestedIPOption = unit {
    address: addr &ipv4;
};

type IPAddressLeaseTimeOption = unit {
    lease_time: uint32 &convert=cast<interval>($$);
};

type ServerIdentifierOption = unit {
    server_id: addr &ipv4;
};

type ParameterRequestListOption = unit {
    parameters: uint8[];
};

type MaximumMessageSizeOption = unit {
    max_size: uint16;
};

type ClientIdentifierOption = unit {
    identifier: bytes &eod;
};

type HostNameOption = unit {
    hostname: bytes &eod &convert=$$.decode();
};

type VendorClassIdentifierOption = unit {
    vendor_class: bytes &eod &convert=$$.decode();
};

type VendorSpecificInformationOption = unit {
    vendor_data: bytes &eod;
};

type RelayAgentInformationOption = unit {
