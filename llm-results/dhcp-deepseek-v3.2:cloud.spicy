        case 122 -> : CCCOption;
        case 123 -> : GeoConfOption;
        case 124 -> : VendorIdentifyingVendorClassOption;
        case 125 -> : VendorIdentifyingVendorSpecificInformationOption;
        case 128 -> : TFTPServerNameOption;
        case 129 -> : BootfileNameOption;
        case 130 -> : MobileIPHomeAgentOption;
        case 131 -> : SimpleMailTransportProtocolServerOption;
        case 132 -> : PostOfficeProtocolServerOption;
        case 133 -> : NetworkNewsTransportProtocolServerOption;
