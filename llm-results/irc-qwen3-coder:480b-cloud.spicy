module IRC;

public type Message = unit {
    : /:(?=<([^\\s]+)\\s)?/;
    prefix: Prefix ?prefix_set;
    command: Command;
    params: Params ?params_set;
    : b"\\r\\n";
};

type Prefix = unit {
    : b":";
    server_or_nick: NickOrServer;
    user_host: UserHostPart ?user_host_set;
};

type UserHostPart = unit {
    : b"!";
    user: b"[^@\\s]+";
    : b"@";
    host: b"[^\\s]+";
};

type Command = unit {
    cmd: b"[A-Za-z]+|[0-9]{3}";
};

type Params = unit {
    params_list: Param[] &eod;
};

type Param = unit {
    : b" ";
    is_trailing: bool &convert=(self.input.startswith(b":")) ;
    switch ( self.is_trailing ) {
        True -> trailing_data: TrailingParam;
        False -> middle_data: MiddleParam;
    };
};

type TrailingParam = unit {
    : b":";
    data: bytes &to_eol &convert=$$.rstrip(b"\\r\\n");
};

type MiddleParam = unit {
    data: bytes &to_space_or_eol &convert=$$.rstrip(b" ");
};

const NickOrServer = b"[^!@\\s]+";
const Letter = b"[a-zA-Z]";
const Number = b"[0-9]";
const Special = b"[-\\[\\]\\\\`^{}]";
const Nick = Letter + b"(?:" + Letter + b"|" + Number + b"|" + Special + b")*";
const UserName = b"[^\\s@]+";
const HostName = b"[a-zA-Z0-9][-a-zA-Z0-9]*(?:\\.[a-zA-Z0-9][-a-zA-Z0-9]*)*";
const Channel = b"[#&][^ \\a\\,]*";
const Target = b"[^,]+";
const Mask = b"[#$][^ \\a\\,]*";

# Helper attributes for conditional parsing
attribute prefix_set = /(?=:[^\\s])/;
attribute params_set = /(?=\\s)/;
attribute user_host_set = /(?=!)/;
attribute is_trailing = /(?=:)/;
attribute to_eol = /[^\\r\\n]*/;
attribute to_space_or_eol = /[^\\s\\r\\n]+/;