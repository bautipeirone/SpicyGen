module HTTP;

public type Message = unit {
    switch {
        -> request: Request;
        -> response: Response;
    };
};

type Request = unit {
    line: RequestLine;
    headers: HeaderFields[];
        : b"\r\n";
    body: Body &size=self._body_size();
};

type Response = unit {
    line: StatusLine;
    headers: HeaderFields[];
        : b"\r\n";
    body: Body &size=self._body_size();
};

type RequestLine = unit {
    method: Method;
    : b" ";
    uri: RequestURI;
    : b" ";
    version: Version;
    : b"\r\n";
};

type StatusLine = unit {
    version: Version;
    : b" ";
    code: StatusCode;
    : b" ";
    reason: ReasonPhrase;
    : b"\r\n";
};

type Method = unit {
    switch {
        b"OPTIONS"  -> : void;
        b"GET"      -> : void;
        b"HEAD"     -> : void;
        b"POST"     -> : void;
        b"PUT"      -> : void;
        b"DELETE"   -> : void;
        b"TRACE"    -> : void;
        b"CONNECT"  -> : void;
        *           -> token: Token;
    };
};

type RequestURI = unit {
    switch {
        b"*"        -> : void;
        -> absolute_uri: AbsoluteURI;
        -> abs_path: AbsPath;
        -> authority: Authority;
    };
};

type Version = unit {
    : b"HTTP/";
    major: uint8;
    : b".";
    minor: uint8;
};

type StatusCode = unit {
    code: uint16 &size=3;
};

type ReasonPhrase = unit {
    phrase: bytes &until=b"\r\n";
};

type HeaderFields = unit {
    name: Token;
    : b":";
    value: bytes &until=b"\r\n";
};

type Body = unit {
    data: bytes &eod;
};

# Helper types for URIs and paths
type AbsoluteURI = unit {
    uri: bytes &until=b" ";
};

type AbsPath = unit {
    path: bytes &until=b" ";
};

type Authority = unit {
    authority: bytes &until=b" ";
};

type Token = unit {
    token: bytes &until=b" ";
};

# Helper function to calculate body size from headers
function _body_size(): uint64 {
    # This would need to parse Content-Length or Transfer-Encoding headers
    # For simplicity, returning 0, as proper implementation requires header parsing
    return 0;
}