module DHCP;

public type DHCPMessage = unit {
    op: uint8;
    htype: uint8;
    hlen: uint8;
    hops: uint8;
    xid: uint32;
    secs: uint16;
    flags: uint16;
    ciaddr: uint32;
    yiaddr: uint32;
    siaddr: uint32;
    giaddr: uint32;
    chaddr: bytes &size=16;
    sname: bytes &size=64;
    file: bytes &size=128;
    options: DHCPOptions;
};

type DHCPOptions = unit {
    magic_cookie: uint32 &requires=($$ == 0x63825363);
    options: DHCPMessageType[] &eod;
};

type DHCPMessageType = unit {
    option_type: uint8;
    option_length: uint8;
    option_data: bytes &size=self.option_length;
};