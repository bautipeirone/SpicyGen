module DHCP;

public type MessageType = enum {
    DHCPDISCOVER = 1,
    DHCPOFFER    = 2,
    DHCPREQUEST  = 3,
    DHCPDECLINE  = 4,
    DHCPACK      = 5,
    DHCPNAK      = 6,
    DHCPRELEASE  = 7,
    DHCPINFORM   = 8
};

public type OpCode = enum {
    BOOTREQUEST = 1,
    BOOTREPLY   = 2
};

public type HType = enum {
    ETHERNET = 1
};

public type Flags = unit {
    #broadcast: uint8 &bitfield=1 &requires=($$ == 0 || $$ == 1);
    #mbz:       uint8 &bitfield=15 &requires=($$ == 0);
    : bitfield(16) {
      broadcast: 0;
      mbz: 1..15;
    };
};

public type DHCPMessage = unit {
    op:      uint8; # 1 = BOOTREQUEST, 2 = BOOTREPLY
    htype:   uint8; # hardware address type
    hlen:    uint8; # hardware address length
    hops:    uint8; # client sets to zero
    xid:     uint32; # transaction ID
    secs:    uint16; # seconds elapsed since client began address acquisition
    flags:   Flags; # flags
    ciaddr:  uint32; # client IP address
    yiaddr:  uint32; # 'your' (client) IP address
    siaddr:  uint32; # IP address of next server to use in bootstrap
    giaddr:  uint32; # relay agent IP address
    chaddr:  uint8[16]; # client hardware address
    sname:   uint8[64]; # optional server host name
    filename:    uint8[128]; # boot file name
    options: DHCPOptions;
};

public type DHCPOption = unit {
    code:   uint8;
    length: uint8;
    data:   uint8[self.length];
};

public type DHCPOptions = unit {
    #magic_cookie: uint8[4] &requires=($$[0] == b"\x63\x82\x53\x63");
    magic_cookie: b"\x63\x82\x53\x63";
    options:      DHCPOption[] &eod;
};