module DHCP;

type MessageType = enum {
    DHCPDISCOVER = 1,
    DHCPOFFER    = 2,
    DHCPREQUEST  = 3,
    DHCPDECLINE  = 4,
    DHCPACK      = 5,
    DHCPNAK      = 6,
    DHCPRELEASE  = 7,
    DHCPINFORM   = 8,
};

type OpCode = enum {
    BOOTREQUEST = 1,
    BOOTREPLY   = 2,
};

public type Packet = unit {
    op: uint8 &convert=OpCode($$);
    htype: uint8;
    hlen: uint8;
    hops: uint8;
    xid: uint32;
    secs: uint16;
    flags: uint16;
    ciaddr: addr &ipv4;
    yiaddr: addr &ipv4;
    siaddr: addr &ipv4;
    giaddr: addr &ipv4;
    chaddr: bytes &size=16;
    sname: bytes &size=64 &convert=$$.split1(b"\0")[0].decode();
    file: bytes &size=128 &convert=$$.split1(b"\0")[0].decode();
    options: Options;
};

type Options = unit {
    magic_cookie: uint32 &requires=($$ == 0x63825363);
    opts: DhcpOption[];
    : b"\xff"; # End option
};

type DhcpOption = unit {
    code: uint8;
    len: uint8;
    switch (self.code) {
        1  -> subnet_mask: addr &ipv4 &size=self.len;
        3  -> routers: addr[] &ipv4 &size=self.len;
        6  -> dns_servers: addr[] &ipv4 &size=self.len;
        12 -> hostname: bytes &size=self.len &convert=$$.decode();
        15 -> domain_name: bytes &size=self.len &convert=$$.decode();
        28 -> broadcast_address: addr &ipv4 &size=self.len;
        44 -> netbios_name_servers: addr[] &ipv4 &size=self.len;
        51 -> ip_address_lease_time: uint32 &size=self.len;
        53 -> dhcp_message_type: uint8 &convert=MessageType($$) &size=self.len;
        54 -> server_identifier: addr &ipv4 &size=self.len;
        55 -> parameter_request_list: uint8[] &size=self.len;
        57 -> max_dhcp_message_size: uint16 &size=self.len;
        58 -> renewal_time_value: uint32 &size=self.len;
        59 -> rebinding_time_value: uint32 &size=self.len;
        60 -> vendor_class_identifier: bytes &size=self.len;
        61 -> client_identifier: bytes &size=self.len;
        66 -> tftp_server_name: bytes &size=self.len &convert=$$.decode();
        67 -> boot_file_name: bytes &size=self.len &convert=$$.decode();
        *  -> unknown_data: bytes &size=self.len;
    };
};