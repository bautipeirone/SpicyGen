module DHCP;

# DHCP Message Format (RFC 2131)

type OpCode = enum {
    BOOTREQUEST = 1,
    BOOTREPLY = 2,
};

public type DHCPMessage = unit {
    op: uint8 &convert=OpCode($$);
    htype: uint8;
    hlen: uint8;
    hops: uint8;
    xid: uint32;
    secs: uint16;
    flags: bitfield(16) {
        broadcast: 0;
        mbz: 1..15;
    };
    ciaddr: addr &ipv4;
    yiaddr: addr &ipv4;
    siaddr: addr &ipv4;
    giaddr: addr &ipv4;
    chaddr: bytes &size=16;
    sname: bytes &size=64 &convert=$$.split1(b"\0")[0].decode();
    filename: bytes &size=128 &convert=$$.split1(b"\0")[0].decode();
    
    # The options field is variable length.
    # The first 4 octets are the magic cookie (99, 130, 83, 99).
    magic_cookie: b"\x63\x82\x53\x63";
    options: bytes &eod;
};