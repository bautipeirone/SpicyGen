module TFTP;

type Opcode = enum {
    RRQ = 1,
    WRQ = 2,
    DATA = 3,
    ACK = 4,
    ERROR = 5,
};

public type Packet = unit {
    opcode: uint16 &convert=Opcode($$);
    switch (self.opcode) {
        Opcode::RRQ,
        Opcode::WRQ -> request: Request;
        Opcode::DATA -> data: Data;
        Opcode::ACK -> ack: Ack;
        Opcode::ERROR -> error: Error;
        * -> : void;
    };
};

type Request = unit {
    filename: bytes &until=b"\0" &convert=$$.split1(b"\0")[0].decode();
    mode: bytes &until=b"\0" &convert=$$.split1(b"\0")[0].decode();
};

type Data = unit {
    block_number: uint16;
    data: bytes &size=512 &requires=(len(self.data) <= 512);
};

type Ack = unit {
    block_number: uint16;
};

type Error = unit {
    error_code: uint16;
    error_message: bytes &until=b"\0" &convert=$$.split1(b"\0")[0].decode();
};