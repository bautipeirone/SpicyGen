module DNS;

type Label = unit {
    len: uint8 &requires=($$ <= 63);
    data: bytes &size=self.len;
};

type DomainName = unit {
    # Use a different name for the end-of-name field
    switch {
        -> label: Label;
        -> terminator: uint8 &requires=($$ == 0);
    };
};

public type Message = unit {
    id: uint16;
    flags: uint16;
    qdcount: uint16;
    ancount: uint16;
    nscount: uint16;
    arcount: uint16;
};