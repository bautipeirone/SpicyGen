module IRC;

# IRC Protocol Grammar based on RFC 1459

const SPACE = b" ";
const CRLF = b"\r\n";

public type Message = unit {
    # Optional prefix
    prefix: bytes &until=SPACE if (self.peek(1) == b":");
    
    # Command
    command: bytes &until=SPACE;
    
    # Parameters
    params: bytes &until=CRLF;
    
    : CRLF;
};