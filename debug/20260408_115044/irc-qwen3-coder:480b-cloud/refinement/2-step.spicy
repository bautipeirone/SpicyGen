module IRC;

const CR = b"\x0d";
const LF = b"\x0a";
const CRLF = b"\x0d\x0a";

const Nickname = /[a-zA-Z\[\]\\`_^{|}][a-zA-Z0-9\[\]\\`_^{|}-]*/;
const Channel = /[&#][^ \a\t\r\n,]+/;
const ServerName = /[a-zA-Z0-9][a-zA-Z0-9.-]*/;
const Host = /[a-zA-Z0-9][a-zA-Z0-9.-]*/;
const User = /[^ @]+/;
const MessageText = /[^:\r\n][^\r\n]*/;

public type Message = unit {
    prefix: Prefix?;
    command: Command;
    params: Parameter[] &until=CRLF;
};

type Prefix = unit {
    : b":";
    server_or_nick: bytes &until=b" ";
    user_host_part: UserHostPart?;
};

type UserHostPart = unit {
    : b"!";
    user: bytes &until=b"@";
    : b"@";
    host: bytes &until=b" ";
};

type Command = unit {
    cmd: bytes &until=b" ";
};

type Parameter = unit {
    : b" ";
    is_trailing: bool &optional;
    param: bytes &until=(self.is_trailing ? CRLF : b" ");
};

# Mark parameter as trailing if it starts with ':'
function Parameter::init() {
    if (param.startswith(b":")) {
        is_trailing = True;
        param = param[1:];
    } else {
        is_trailing = False;
    }
}