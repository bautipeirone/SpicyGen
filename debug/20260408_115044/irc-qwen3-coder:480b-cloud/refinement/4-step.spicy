module IRC;

const CRLF = b"\x0d\x0a";
const SPACE = b" ";
const COLON = b":";

# Basic IRC message structure
public type Message = unit {
    has_prefix: bool &convert=($$ == b":");
    prefix_data: PrefixData? if(self.has_prefix);
    command: bytes &until=(bytes.contains(SPACE) || bytes.contains(CRLF));
    params: Parameter[];
    : CRLF;
};

type PrefixData = unit {
    : b":";
    prefix: bytes &until=SPACE;
    : SPACE;
};

type Parameter = unit {
    data: bytes &until=(bytes.contains(SPACE) || bytes.contains(CRLF));
};