module IRC;

const CRLF = b"\x0d\x0a";
const SPACE = b" ";

# Basic IRC message structure
public type Message = unit {
    prefix_part: PrefixPart?;
    command: bytes &until=(bytes.contains(SPACE) || bytes.contains(CRLF));
    : SPACE;
    params: Parameter[];
    : CRLF;
};

type PrefixPart = unit {
    : b":";
    prefix: bytes &until=SPACE;
    : SPACE;
};

type Parameter = unit {
    is_trailing: bool &convert=($$.startswith(b":"));
    param_data: bytes &until=(bytes.contains(SPACE) || bytes.contains(CRLF)) 
               &convert=(self.is_trailing ? $$.slice(1) : $$);
};