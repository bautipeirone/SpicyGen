module RTSP;

type RTSPVersion = unit {
    : b"RTSP/";
    major: uint8;
    : b".";
    minor: uint8;
};

type RequestLine = unit {
    method: bytes &until=b" ";
    uri: bytes &until=b" ";
    version: RTSPVersion;
    : b"\r\n";
};

type StatusLine = unit {
    version: RTSPVersion;
    : b" ";
    code: uint16;
    : b" ";
    reason: bytes &until=b"\r\n";
};

type Header = unit {
    name: bytes &until=b":";
    : b" ";
    value: bytes &until=b"\r\n";
};

public type Message = unit {
    switch {
        -> request: RequestLine;
        -> response: StatusLine;
    };
    headers: Header[];
    : b"\r\n";
    body: bytes &eod if (self.has_body());
} &let {
    has_body: bool = True; # Simplified for grammar structure
};