module HTTP;

public type HTTPMessage = unit {
    _: /^\s*/; # Skip leading whitespace
    message: Message;
};

type Message = unit {
    start_line: StartLine;
    headers: HeaderFields;
    _: CRLF;
    body: bytes &eod &size=self._body_size();
};

type StartLine = unit {
    line: /.*\r\n/;
    parsed: StartLineParsed &convert=self._parse_start_line($$);
};

type StartLineParsed = unit {
    method_or_version: bytes;
    uri_or_status: bytes;
    version_or_reason: bytes;
};

type HeaderFields = unit {
    fields: HeaderField[];
    : CRLF;
};

type HeaderField = unit {
    name: token;
    _: /:[ \t]*/;
    value: /.*\r\n/ &convert=$$.rstrip(b"\r\n");
};

const CRLF = /\r\n/;
const token = /[^()<>@,;:\\"\/\[\]?={} \t]+/;

# Helper functions (would be implemented in Spicy or host script)
function StartLine._parse_start_line(line: bytes): StartLineParsed {
    # Placeholder for parsing logic
    # Actual implementation would split the line into components
    # This is simplified for illustration
    auto parts = split(line, b" ");
    return StartLineParsed{
        method_or_version: parts.size() > 0 ? parts[0] : b"",
        uri_or_status: parts.size() > 1 ? parts[1] : b"",
        version_or_reason: parts.size() > 2 ? join(slice(parts, 2), b" ") : b""
    };
}

function Message._body_size(): uint64 {
    # Placeholder for body size calculation
    # Would need to check Content-Length, Transfer-Encoding, etc.
    return 0; # Simplified
}