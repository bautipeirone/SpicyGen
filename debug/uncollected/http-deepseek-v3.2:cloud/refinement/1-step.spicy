module HTTP;

# Basic tokens and delimiters
const CRLF = /\r\n/;
const SP = / /;
const HT = /\t/;
const LWS = /(?:\r\n)?[ \t]+/;
const Token = /[^ \t\r\n\(\)<>@,;:\\"\/\[\]?={}]+/;
const QuotedString = /"([^"\\]|\\.)*"/;
const Comment = /\(([^()]|\([^()]*\))*\)/;

# HTTP version
const HTTPVersion = /HTTP\/\d+\.\d+/;

# Methods
type Method = enum {
    OPTIONS = 0,
    GET,
    HEAD,
    POST,
    PUT,
    DELETE,
    TRACE,
    CONNECT,
    extension_method = 255
};

# Status codes
type StatusCode = enum {
    Continue = 100,
    SwitchingProtocols = 101,
    OK = 200,
    Created = 201,
    Accepted = 202,
    NonAuthoritativeInformation = 203,
    NoContent = 204,
    ResetContent = 205,
    PartialContent = 206,
    MultipleChoices = 300,
    MovedPermanently = 301,
    Found = 302,
    SeeOther = 303,
    NotModified = 304,
    UseProxy = 305,
    TemporaryRedirect = 307,
    BadRequest = 400,
    Unauthorized = 401,
    PaymentRequired = 402,
    Forbidden = 403,
    NotFound = 404,
    MethodNotAllowed = 405,
    NotAcceptable = 406,
    ProxyAuthenticationRequired = 407,
    RequestTimeout = 408,
    Conflict = 409,
    Gone = 410,
    LengthRequired = 411,
    PreconditionFailed = 412,
    RequestEntityTooLarge = 413,
    RequestURITooLong = 414,
    UnsupportedMediaType = 415,
    RequestedRangeNotSatisfiable = 416,
    ExpectationFailed = 417,
    InternalServerError = 500,
    NotImplemented = 501,
    BadGateway = 502,
    ServiceUnavailable = 503,
    GatewayTimeout = 504,
    HTTPVersionNotSupported = 505,
    extension_code = 599
};

# Date formats
const RFC1123Date = /(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun), \d{2} (?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) \d{4} \d{2}:\d{2}:\d{2} GMT/;
const RFC850Date = /(?:Monday|Tuesday|Wednesday|Thursday|Friday|Saturday|Sunday), \d{2}-(?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)-\d{2} \d{2}:\d{2}:\d{2} GMT/;
const AsctimeDate = /(?:Mon|Tue|Wed|Thu|Fri|Sat|Sun) (?:Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) [ \d]\d \d{2}:\d{2}:\d{2} \d{4}/;
const HTTPDate = RFC1123Date | RFC850Date | AsctimeDate;

# URI (simplified)
const AbsoluteURI = /[a-zA-Z][a-zA-Z0-9+.-]*:\/\/[^ \t\r\n]+/;
const AbsPath = /\/[^ \t\r\n]*/;
const Authority = /[^ \t\r\n]+/;

# Header field
type HeaderField = unit {
    name: Token;
    : /:[ \t]*/;
    value: bytes &until=CRLF;
};

# Request-Line
type RequestLine = unit {
    method: uint8 &convert=Method($$);
    : SP;
    request_uri: bytes &until=SP;
    : SP;
    http_version: HTTPVersion;
    : CRLF;
};

# Status-Line
type StatusLine = unit {
    http_version: HTTPVersion;
    : SP;
    status_code: uint16 &convert=StatusCode($$);
    : SP;
    reason_phrase: bytes &until=CRLF;
    : CRLF;
};

# Chunked transfer coding
type Chunk = unit {
    chunk_size: /[0-9a-fA-F]+/;
    chunk_extensions: bytes &until=CRLF;
    : CRLF;
    chunk_data: bytes &size=chunk_size.to_uint(16);
    : CRLF;
};

type LastChunk = unit {
    : /0/;
    chunk_extensions: bytes &until=CRLF;
    : CRLF;
};

type Trailer = unit {
    trailer_fields: HeaderField[];
    : CRLF;
};

type ChunkedBody = unit {
    chunks: Chunk[];
    last_chunk: LastChunk;
    trailer: Trailer;
};

# Main message types
public type Request = unit {
    start_line: RequestLine;
    headers: HeaderField[];
    : CRLF;
    switch (self.start_line.method) {
        Method::POST,
        Method::PUT -> body: bytes &eod;
        * -> : void;
    };
};

public type Response = unit {
    start_line: StatusLine;
    headers: HeaderField[];
    : CRLF;
    body: bytes &eod if(self.start_line.status_code not in {StatusCode::NoContent, StatusCode::NotModified, StatusCode::ResetContent});
};

# Alternative: Generic HTTP message that can be either request or response
public type HTTPMessage = unit {
    switch {
        -> request: Request;
        -> response: Response;
    };
};