module HTTP;

const CRLF = /\r\n/;
const SP = / /;
const HT = /\t/;
const LWS = /[\r\n]*[ \t]+/;
const Token = /[^()<>@,;:\\"\/\[\]?={} \t\r\n]+/;
const QuotedString = /"([^"\\]|\\.)*"/;
const Comment = /\(([^()]|\([^()]*\))*\)/;
const HTTP_Version = /HTTP\/\d+\.\d+/;
const AbsoluteURI = /[a-zA-Z][a-zA-Z0-9+.-]*:/;
const AbsPath = /\/[^ \t\r\n]*/;
const Authority = /[^\/?# \t\r\n]+/;
const StatusCode = /\d{3}/;
const ReasonPhrase = /[^\r\n]*/;
const FieldName = Token;
const FieldValue = /[^\r\n]*/;
const ChunkSize = /[0-9A-Fa-f]+/;
const ChunkExtName = Token;
const ChunkExtVal = /[^; \t\r\n]+/;
const QValue = /0(\.[0-9]{0,3})?|1(\.[0]{0,3})?/;
const LanguageTag = /[a-zA-Z]{1,8}(-[a-zA-Z]{1,8})*/;
const EntityTag = /W\/"[^"]*"|"[^"]*"/;
const RangeUnit = /bytes|other/;
const DeltaSeconds = /\d+/;
const ProductToken = Token;
const Charset = Token;
const ContentCoding = Token;
const TransferCoding = Token;
const MediaType = Token;
const Parameter = Token;

type Request_Line = unit {
    method: Token;
    : SP;
    request_uri: (AbsoluteURI | AbsPath | Authority | b"*");
    : SP;
    http_version: HTTP_Version;
    : CRLF;
};

type Status_Line = unit {
    http_version: HTTP_Version;
    : SP;
    status_code: StatusCode;
    : SP;
    reason_phrase: ReasonPhrase;
    : CRLF;
};

type Header = unit {
    name: FieldName;
    : /:[ \t]*/;
    value: FieldValue;
    : CRLF;
};

type Chunk = unit {
    chunk_size: ChunkSize;
    chunk_extensions: (b";" ChunkExtName (b"=" ChunkExtVal)?)*;
    : CRLF;
    chunk_data: bytes &size=chunk_size.to_int(16);
    : CRLF;
};

type Trailer = unit {
    trailers: Header[];
};

type ChunkedBody = unit {
    chunks: Chunk[];
    last_chunk: b"0" (b";" ChunkExtName (b"=" ChunkExtVal)?)* CRLF;
    trailer: Trailer;
    : CRLF;
};

public type Request = unit {
    start_line: Request_Line;
    headers: Header[];
    : CRLF;
    body: bytes &eod;
};

public type Response = unit {
    start_line: Status_Line;
    headers: Header[];
    : CRLF;
    body: bytes &eod;
};

public type HTTP_Message = unit {
    switch {
        -> request: Request;
        -> response: Response;
    };
};