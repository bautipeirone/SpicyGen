module HTTP;

const CRLF = /\r\n/;
const LWS = /[ \t]+/;
const Token = /[^ \t\r\n()<>@,;:\\"\/\[\]?={}]+/;
const QuotedString = /"([^"\\]|\\.)*"/;
const Comment = /\(([^()]|\([^()]*\))*\)/;
const Separators = /[()<>@,;:\\"\/\[\]?={} \t]/;
const Hex = /[0-9A-Fa-f]/;
const DeltaSeconds = /[0-9]+/;
const Charset = Token;
const ContentCoding = Token;
const TransferCoding = Token;
const MediaType = Token "/" Token;
const LanguageTag = /[a-zA-Z]{1,8}(-[a-zA-Z0-9]{1,8})*/;
const OpaqueTag = QuotedString;
const EntityTag = /[Ww]?\/ / OpaqueTag;
const RangeUnit = Token;
const Product = Token "/" Token;
const QValue = /0(\.[0-9]{0,3})?|1(\.[0]{0,3})?/;
const Host = /[^:]+/;
const Port = /[0-9]+/;
const AbsoluteURI = /[a-zA-Z][a-zA-Z0-9+.-]*:/;
const AbsPath = /\/[^?#]*/;
const Authority = Host (":" Port)?;
const RequestURI = /\*|/ AbsoluteURI "|" AbsPath "|" Authority;
const HTTPVersion = /HTTP\/[0-9]+\.[0-9]+/;
const StatusCode = /[0-9]{3}/;
const ReasonPhrase = /[^\r\n]*/;
const FieldName = Token;
const FieldValue = /[^\r\n]*/;
const ChunkSize = Hex+;
const ChunkExtName = Token;
const ChunkExtVal = Token | QuotedString;
const ChunkData = bytes &size=chunk_size;
const Trailer = Header[];

type Method = enum {
    OPTIONS = 1,
    GET = 2,
    HEAD = 3,
    POST = 4,
    PUT = 5,
    DELETE = 6,
    TRACE = 7,
    CONNECT = 8,
    extension = 9
};

type StatusCodeEnum = enum {
    Continue = 100,
    SwitchingProtocols = 101,
    OK = 200,
    Created = 201,
    Accepted = 202,
    NonAuthoritativeInformation = 203,
    NoContent = 204,
    ResetContent = 205,
    PartialContent = 206,
    MultipleChoices = 300,
    MovedPermanently = 301,
    Found = 302,
    SeeOther = 303,
    NotModified = 304,
    UseProxy = 305,
    TemporaryRedirect = 307,
    BadRequest = 400,
    Unauthorized = 401,
    PaymentRequired = 402,
    Forbidden = 403,
    NotFound = 404,
    MethodNotAllowed = 405,
    NotAcceptable = 406,
    ProxyAuthenticationRequired = 407,
    RequestTimeout = 408,
    Conflict = 409,
    Gone = 410,
    LengthRequired = 411,
    PreconditionFailed = 412,
    RequestEntityTooLarge = 413,
    RequestURITooLong = 414,
    UnsupportedMediaType = 415,
    RequestedRangeNotSatisfiable = 416,
    ExpectationFailed = 417,
    InternalServerError = 500,
    NotImplemented = 501,
    BadGateway = 502,
    ServiceUnavailable = 503,
    GatewayTimeout = 504,
    HTTPVersionNotSupported = 505,
    extension = 506
};

type Header = unit {
    name: FieldName;
    : b":";
    : LWS?;
    value: FieldValue;
    : CRLF;
};

type RequestLine = unit {
    method: Token &convert=Method($$);
    : b" ";
    request_uri: RequestURI;
    : b" ";
    http_version: HTTPVersion;
    : CRLF;
};

type StatusLine = unit {
    http_version: HTTPVersion;
    : b" ";
    status_code: StatusCode &convert=StatusCodeEnum($$.to_int());
    : b" ";
    reason_phrase: ReasonPhrase;
    : CRLF;
};

type Chunk = unit {
    chunk_size: ChunkSize &convert=$$.to_uint(16);
    chunk_extensions: (b";" ChunkExtName (b"=" (ChunkExtVal))?)*;
    : CRLF;
    chunk_data: bytes &size=self.chunk_size;
    : CRLF;
};

type ChunkedBody = unit {
    chunks: Chunk[] until(self.chunks[-1].chunk_size == 0);
    trailer: Header[] until(b"\r\n");
    : CRLF;
};

type GeneralHeaders = unit {
    cache_control: Header if(self.name == "Cache-Control");
    connection: Header if(self.name == "Connection");
    date: Header if(self.name == "Date");
    pragma: Header if(self.name == "Pragma");
    trailer: Header if(self.name == "Trailer");
    transfer_encoding: Header if(self.name == "Transfer-Encoding");
    upgrade: Header if(self.name == "Upgrade");
    via: Header if(self.name == "Via");
    warning: Header if(self.name == "Warning");
};

type RequestHeaders = unit {
    accept: Header if(self.name == "Accept");
    accept_charset: Header if(self.name == "Accept-Charset");
    accept_encoding: Header if(self.name == "Accept-Encoding");
    accept_language: Header if(self.name == "Accept-Language");
    authorization: Header if(self.name == "Authorization");
    expect: Header if(self.name == "Expect");
    from: Header if(self.name == "From");
    host: Header if(self.name == "Host");
    if_match: Header if(self.name == "If-Match");
    if_modified_since: Header if(self.name == "If-Modified-Since");
    if_none_match: Header if(self.name == "If-None-Match");
    if_range: Header if(self.name == "If-Range");
    if_unmodified_since: Header if(self.name == "If-Unmodified-Since");
    max_forwards: Header if(self.name == "Max-Forwards");
    proxy_authorization: Header if(self.name == "Proxy-Authorization");
    range: Header if(self.name == "Range");
    referer: Header if(self.name == "Referer");
    te: Header if(self.name == "TE");
    user_agent: Header if(self.name == "User-Agent");
};

type ResponseHeaders = unit {
    accept_ranges: Header if(self.name == "Accept-Ranges");
    age: Header if(self.name == "Age");
    etag: Header if(self.name == "ETag");
    location: Header if(self.name == "Location");
    proxy_authenticate: Header if(self.name == "Proxy-Authenticate");
    retry_after: Header if(self.name == "Retry-After");
    server: Header if(self.name == "Server");
    vary: Header if(self.name == "Vary");
    www_authenticate: Header if(self.name == "WWW-Authenticate");
};

type EntityHeaders = unit {
    allow: Header if(self.name == "Allow");
    content_encoding: Header if(self.name == "Content-Encoding");
    content_language: Header if(self.name == "Content-Language");
    content_length: Header if(self.name == "Content-Length");
    content_location: Header if(self.name == "Content-Location");
    content_md5: Header if(self.name == "Content-MD5");
    content_range: Header if(self.name == "Content-Range");
    content_type: Header if(self.name == "Content-Type");
    expires: Header if(self.name == "Expires");
    last_modified: Header if(self.name == "Last-Modified");
    extension_header: Header;
};

type Headers = unit {
    general_headers: GeneralHeaders[];
    request_or_response_headers: (RequestHeaders | ResponseHeaders)[];
    entity_headers: EntityHeaders[];
};

type Request = unit {
    request_line: RequestLine;
    headers: Headers;
    : CRLF;
    message_body: bytes &eod if(self.request_line.method != Method::HEAD && 
                               self.headers.entity_headers.content_length.exists() &&
                               self.headers.entity_headers.content_length.value.to_int() > 0);
};

type Response = unit {
    status_line: StatusLine;
    headers: Headers;
    : CRLF;
    message_body: bytes &eod if(self.status_line.status_code != StatusCodeEnum::NoContent &&
                               self.status_line.status_code != StatusCodeEnum::NotModified &&
                               !(self.status_line.status_code >= 100 && self.status_line.status_code < 200));
};

public type HTTPMessage = unit {
    switch {
        -> request: Request;
        -> response: Response;
    };
};