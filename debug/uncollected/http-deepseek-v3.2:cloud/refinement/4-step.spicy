module HTTP;

# Basic tokens and constants
const SP = / /;
const HT = /\t/;
const CRLF = /\r\n/;
const LWS = /(?:\r\n)?[ \t]+/;
const Token = /[^ \t\r\n()<>@,;:\\"\/\[\]?={}]+/;
const QuotedString = /"([^"\\]|\\.)*"/;
const Comment = /\(([^()]|\([^()]*\))*\)/;
const Separators = /[()<>@,;:\\"\/\[\]?={} \t]/;

# HTTP version
type HTTPVersion = unit {
    : b"HTTP/";
    major: /[0-9]+/ &convert=$$.to_uint();
    : b".";
    minor: /[0-9]+/ &convert=$$.to_uint();
};

# Request line
type RequestLine = unit {
    method: Method;
    : SP;
    request_uri: RequestURI &convert=$$.decode();
    : SP;
    version: HTTPVersion;
    : CRLF;
};

type Method = enum {
    OPTIONS = 0,
    GET = 1,
    HEAD = 2,
    POST = 3,
    PUT = 4,
    DELETE = 5,
    TRACE = 6,
    CONNECT = 7,
} &convert=Method($$);

type RequestURI = bytes;

# Status line
type StatusLine = unit {
    version: HTTPVersion;
    : SP;
    status_code: StatusCode &convert=StatusCode($$);
    : SP;
    reason_phrase: ReasonPhrase;
    : CRLF;
};

type StatusCode = uint16;
const ReasonPhrase = /[^\r\n]*/;

# Header field
type Header = unit {
    field_name: Token;
    : b":";
    field_value: HeaderValue;
    : CRLF;
};

const HeaderValue = /[^\r\n]*/;

# Headers list
# type Headers = Header[];

# Chunked transfer encoding
type ChunkedBody = unit {
    chunks: Chunk[];
    last_chunk: LastChunk;
    trailer: Trailer;
    : CRLF;
};

type Chunk = unit {
    chunk_size: /[0-9a-fA-F]+/ &convert=$$.to_uint(16);
    chunk_extension: ChunkExtension if($$ > 0);
    : CRLF;
    chunk_data: bytes &size=self.chunk_size;
    : CRLF;
};

type ChunkExtension = unit {
    : b";";
    ext_name: Token;
    #ext_val: (b"=" (Token | QuotedString))?;
};

type LastChunk = unit {
    : b"0";
    #chunk_extension: ChunkExtension?;
    : CRLF;
};

type Trailer = Header[];

# Main message types
public type Request = unit {
    start_line: RequestLine;
    headers: Header[];
    : CRLF;
    body: MessageBody;
};

public type Response = unit {
    start_line: StatusLine;
    headers: Header[];
    : CRLF;
    body: MessageBody;
};

# Message body handling
type MessageBody = unit {
    switch {
        -> chunked: ChunkedBody if(has_header(self.parent.headers, b"Transfer-Encoding", b"chunked"));
        -> fixed: bytes &size=get_content_length(self.parent.headers);
        -> eod: bytes &eod;
    };
};

# Helper functions (conceptual - would need implementation)
function has_header(headers: Header[], name: bytes, value: bytes): bool {
    # Implementation would check if header exists with given value
    return False;
}

function get_content_length(headers: Header[]): uint64 {
    # Implementation would extract Content-Length header value
    return 0;
}