module IRC;

type Opcode = enum {
    PASS = 0x50415353,      # "PASS"
    NICK = 0x4e49434b,      # "NICK"
    USER = 0x55534552,      # "USER"
    JOIN = 0x4a4f494e,      # "JOIN"
    PART = 0x50415254,      # "PART"
    QUIT = 0x51554954,      # "QUIT"
    PRIVMSG = 0x50524956,   # "PRIVMSG"
    NOTICE = 0x4e4f5449,    # "NOTICE"
    PING = 0x50494e47,      # "PING"
    PONG = 0x504f4e47,      # "PONG"
    MODE = 0x4d4f4445,      # "MODE"
    TOPIC = 0x544f5049,     # "TOPIC"
    KICK = 0x4b49434b,      # "KICK"
    INVITE = 0x494e5649,    # "INVITE"
    NAMES = 0x4e414d45,     # "NAMES"
    LIST = 0x4c495354,      # "LIST"
    WHO = 0x57484f,         # "WHO"
    WHOIS = 0x57484f49,     # "WHOIS"
    WHOWAS = 0x57484f57,    # "WHOWAS"
    KILL = 0x4b494c4c,      # "KILL"
    OPER = 0x4f504552,      # "OPER"
    REHASH = 0x52454841,    # "REHASH"
    RESTART = 0x52455354,   # "RESTART"
    SQUIT = 0x53515549,     # "SQUIT"
    AWAY = 0x41574159,      # "AWAY"
    LINKS = 0x4c494e4b,     # "LINKS"
    STATS = 0x53544154,     # "STATS"
    VERSION = 0x56455253,   # "VERSION"
    TIME = 0x54494d45,      # "TIME"
    CONNECT = 0x434f4e4e,   # "CONNECT"
    TRACE = 0x54524143,     # "TRACE"
    ADMIN = 0x41444d49,     # "ADMIN"
    INFO = 0x494e464f,      # "INFO"
    SERVLIST = 0x53455256,  # "SERVLIST"
    SQUERY = 0x53515545,    # "SQUERY"
    ERROR = 0x4552524f,     # "ERROR"
    SUMMON = 0x53554d4d,    # "SUMMON"
    USERS = 0x55534552,     # "USERS"
    WALLOPS = 0x57414c4c,   # "WALLOPS"
    USERHOST = 0x55534552484f5354, # "USERHOST"
    ISON = 0x49534f4e,      # "ISON"
};

public type Message = unit {
    prefix: Prefix &optional;
    command: Command;
    params: Params;
    crlf: CRLF;
};

type Prefix = unit {
    colon: b":";
    source: Source;
    space: b" ";
};

type Source = unit {
    servername: Servername | nickname: Nickname;
};

type Servername = unit {
    hostname: bytes &convert=$$.rstrip(b"\r\n".encode());
};

type Nickname = unit {
    nick: bytes &convert=$$.rstrip(b"\r\n".encode());
};

type Command = unit {
    opcode: Opcode | numeric: NumericReply;
};

type NumericReply = unit {
    num: uint16;
};

type Params = unit {
    middle_params: MiddleParam[];
    trailing_param: TrailingParam &optional;
};

type MiddleParam = unit {
    space: b" ";
    param: bytes &convert=$$.rstrip(b"\r\n".encode()) &requires(!($$.find(b" ") >= 0));
};

type TrailingParam = unit {
    space: b" ";
    colon: b":";
    text: bytes &eod;
};

type CRLF = unit {
    cr: b"\r";
    lf: b"\n";
};