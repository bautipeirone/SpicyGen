module IRC;

public type Message = unit {
    prefix: Prefix &optional;
    command: Command;
    params: Parameter[] &until=b"\r\n";
};

type Prefix = unit {
    : b":";
    servername: Host;
    : b" ";
};

type Command = unit {
    cmd: bytes &size=4 &convert=$$.rstrip().decode();
};

type Parameter = unit {
    : b" ";
    middle: bytes &until=b" " | b"\r\n";
};

type Host = unit {
    hostname: bytes &until=b" ";
};

type Nick = unit {
    nickname: bytes &until=b"!" | b"@" | b" ";
};