module IRC;

public type Message = unit {
    prefix: Prefix &optional;
    command: Command;
    params: Parameter[] &until=b"\r\n";
};

type Prefix = unit {
    : b":";
    origin: Origin;
    : b" ";
};

type Origin = unit {
    switch {
        -> server_name: ServerName;
        -> nick: Nickname &optional;
        -> user: Username &optional;
        -> host: Hostname &optional;
    };
};

type Command = unit {
    switch {
        -> verb: Verb;
        -> numeric: NumericReply;
    };
};

type Verb = unit {
    value: bytes &until=(b" " | b"\r\n");
};

type NumericReply = unit {
    value: uint16 &size=3;
};

type Parameter = unit {
    : b" ";
    switch {
        -> middle: MiddleParameter;
        -> trailing: TrailingParameter;
    };
};

type MiddleParameter = unit {
    value: bytes &until=(b" " | b"\r\n");
};

type TrailingParameter = unit {
    : b":";
    value: bytes &until=b"\r\n";
};

# Helper types for origin parsing
type ServerName = unit {
    name: bytes &until=(b" " | b"\r\n");
};

type Nickname = unit {
    : b"!";
    name: bytes &until=(b"@" | b" ");
};

type Username = unit {
    : b"@";
    name: bytes &until=(b" " | b"\r\n");
};

type Hostname = unit {
    name: bytes &until=(b" " | b"\r\n");
};