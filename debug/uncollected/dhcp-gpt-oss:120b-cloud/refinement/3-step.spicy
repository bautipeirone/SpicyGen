module dhcp;

public type DHCPMessage = unit {
    # Fixed header fields (RFC 2131, Figure 1)
    op: uint8;
    htype: uint8;
    hlen: uint8;
    hops: uint8;
    xid: uint32;
    secs: uint16;
    flags: uint16;
    ciaddr: uint32;
    yiaddr: uint32;
    siaddr: uint32;
    giaddr: uint32;

    # Client hardware address (16 bytes)
    chaddr: bytes &size=16;

    # Server host name (64 bytes)
    sname: bytes &size=64;

    # Boot file name (128 bytes) – renamed to avoid the reserved keyword “file”
    file_field: bytes &size=128;

    # DHCP magic cookie (must be 99,130,83,99)
    magic_cookie: bytes &size=4;

    # Variable‑length options area (consumes the rest of the DHCP packet)
    options: bytes &eod;
};