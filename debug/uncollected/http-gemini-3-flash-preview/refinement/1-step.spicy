module HTTP;

# Basic Rules and Constants
const CR = b"\x0d";
const LF = b"\x0a";
const CRLF = b"\x0d\x0a";
const SP = b" ";
const HT = b"\x09";
const LWS = /(?:\r?\n)?[ \t]+/;
const Token = /[!#$%&'*+\-.^_`|~0-9a-zA-Z]+/;
const TEXT = /[\x20-\x7E\x80-\xFF\t]+/;
const HEX = /[0-9a-fA-F]/;

# Section 3.1: HTTP Version
type HTTPVersion = unit {
    : b"HTTP/";
    major: /[0-9]+/ &convert=$$.to_uint();
    : b".";
    minor: /[0-9]+/ &convert=$$.to_uint();
};

# Section 3.3.1: Date/Time Formats
const HTTPDate = /[A-Z][a-z]{2}, [0-9]{2} [A-Z][a-z]{2} [0-9]{4} [0-9]{2}:[0-9]{2}:[0-9]{2} GMT/;

# Section 3.6.1: Chunked Transfer Coding
type Chunk = unit {
    chunk_size_hex: /[0-9a-fA-F]+/ &convert=$$.to_uint(16);
    chunk_extension: /(?:;[^\r\n]+)?/;
    : CRLF;
    chunk_data: bytes &size=self.chunk_size_hex;
    : CRLF;
};

type ChunkedBody = unit {
    chunks: Chunk[] &until=b"0\r\n";
    last_chunk: b"0";
    last_extension: /(?:;[^\r\n]+)?/;
    : CRLF;
    trailer: Header[];
    : CRLF;
};

# Section 4.2: Message Headers
type Header = unit {
    name: Token;
    : /:[ \t]*/;
    value: /.*?(?=\r\n[^\t ])/ &convert=$$.decode();
    : CRLF;
};

# Section 5.1: Request-Line
type RequestLine = unit {
    method: Token;
    : SP;
    request_uri: /[^ ]+/;
    : SP;
    version: HTTPVersion;
    : CRLF;
};

# Section 6.1: Status-Line
type StatusLine = unit {
    version: HTTPVersion;
    : SP;
    status_code: /[0-9]{3}/ &convert=$$.to_uint();
    : SP;
    reason_phrase: /[^\r\n]*/;
    : CRLF;
};

# Section 10: Status Code Definitions
type StatusCode = enum {
    Continue = 100,
    SwitchingProtocols = 101,
    OK = 200,
    Created = 201,
    Accepted = 202,
    NonAuthoritativeInformation = 203,
    NoContent = 204,
    ResetContent = 205,
    PartialContent = 206,
    MultipleChoices = 300,
    MovedPermanently = 301,
    Found = 302,
    SeeOther = 303,
    NotModified = 304,
    UseProxy = 305,
    TemporaryRedirect = 307,
    BadRequest = 400,
    Unauthorized = 401,
    PaymentRequired = 402,
    Forbidden = 403,
    NotFound = 404,
    MethodNotAllowed = 405,
    NotAcceptable = 406,
    ProxyAuthenticationRequired = 407,
    RequestTimeout = 408,
    Conflict = 409,
    Gone = 410,
    LengthRequired = 411,
    PreconditionFailed = 412,
    RequestEntityTooLarge = 413,
    RequestURITooLong = 414,
    UnsupportedMediaType = 415,
    RequestedRangeNotSatisfiable = 416,
    ExpectationFailed = 417,
    InternalServerError = 500,
    NotImplemented = 501,
    BadGateway = 502,
    ServiceUnavailable = 503,
    GatewayTimeout = 504,
    HTTPVersionNotSupported = 505,
};

# Section 4: HTTP Message
type Request = unit {
    request_line: RequestLine;
    headers: Header[];
    : CRLF;
    # Body parsing logic usually depends on headers (Content-Length or Transfer-Encoding)
    # For the purpose of this grammar, we capture the remaining data.
    body: bytes &eod;
};

type Response = unit {
    status_line: StatusLine;
    headers: Header[];
    : CRLF;
    body: bytes &eod;
};

# Main Entry Point
public type HTTPMessage = unit {
    switch {
        -> : /HTTP\/[0-9]\.[0-9] [0-9]{3} .*/ {
            response: Response;
        }
        -> : /[A-Z]+ [^ ]+ HTTP\/[0-9]\.[0-9].*/ {
            request: Request;
        }
    };
};

# Specific Header Field Structures (Examples of constraints)
type ContentLengthHeader = unit {
    : b"Content-Length: ";
    length: /[0-9]+/ &convert=$$.to_uint();
    : CRLF;
};

type HostHeader = unit {
    : b"Host: ";
    hostname: /[a-zA-Z0-9.\-]+/;
    port_number: unit {
        : b":";
        p: /[0-9]+/ &convert=$$.to_uint();
    } if(peek(b":"));
    : CRLF;
};

type CacheControlHeader = unit {
    : b"Cache-Control: ";
    directives: unit {
        directive: Token;
        value: unit {
            : b"=";
            v: /[a-zA-Z0-9\-]+|"[^"]*"/;
        } if(peek(b"="));
    }[] &until=CRLF;
};

type RetryAfterHeader = unit {
    : b"Retry-After: ";
    switch {
        -> date: HTTPDate;
        -> seconds: /[0-9]+/ &convert=cast<interval>($$.to_uint());
    };
    : CRLF;
};