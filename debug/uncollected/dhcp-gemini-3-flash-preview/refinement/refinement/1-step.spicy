module DHCP;

# The Dynamic Host Configuration Protocol (DHCP) message format 
# as defined in RFC 2131, Section 2.

public type Message = unit {
    # Message op code / message type. 1 = BOOTREQUEST, 2 = BOOTREPLY
    op: uint8 &requires(($$ == 1) || ($$ == 2));
    
    # Hardware address type (e.g., '1' = 10mb ethernet)
    htype: uint8;
    
    # Hardware address length (e.g. '6' for 10mb ethernet)
    hlen: uint8;
    
    # Client sets to zero, optionally used by relay agents
    hops: uint8;
    
    # Transaction ID, a random number chosen by the client
    xid: uint32;
    
    # Seconds elapsed since client began address acquisition or renewal process
    secs: uint16;
    
    # Flags field including the Broadcast bit
    flags: bitfield(16) {
        broadcast: 0;
        mbz: 1..15;
    };
    
    # Client IP address; filled in if client can respond to ARP requests
    ciaddr: uint32;
    
    # 'your' (client) IP address
    yiaddr: uint32;
    
    # IP address of next server to use in bootstrap
    siaddr: uint32;
    
    # Relay agent IP address, used in booting via a relay agent
    giaddr: uint32;
    
    # Client hardware address (fixed 16 octets, length specified by hlen)
    chaddr: bytes &size=16;
    
    # Optional server host name, null terminated string
    sname: bytes &size=64;
    
    # Boot file name, null terminated string. 
    # Field renamed to boot_file because 'file' is a reserved keyword.
    boot_file: bytes &size=128;
    
    # Magic Cookie for DHCP Options (decimal 99, 130, 83, 99)
    magic_cookie: b"\x63\x82\x53\x63";
    
    # Optional parameters field.
    # The options field is variable length.
    options: Option[] &eod;
};

# DHCP Options format. 
# Most options follow a Tag-Length-Value (TLV) structure.
type Option = unit {
    tag: uint8;
    switch ( self.tag ) {
        # Pad Option
        0   -> : void;
        
        # End Option
        255 -> : void;
        
        # All other options follow Tag-Length-Value
        *   -> data: unit {
            len: uint8;
            value: bytes &size=self.len;
        };
    };
};