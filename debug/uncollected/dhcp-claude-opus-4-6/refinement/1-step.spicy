module DHCP;

# DHCP Message Types
type MessageType = enum {
    DHCPDISCOVER = 1,
    DHCPOFFER = 2,
    DHCPREQUEST = 3,
    DHCPDECLINE = 4,
    DHCPACK = 5,
    DHCPNAK = 6,
    DHCPRELEASE = 7,
    DHCPINFORM = 8,
};

# Op code
type OpCode = enum {
    BOOTREQUEST = 1,
    BOOTREPLY = 2,
};

# Hardware address type (common values)
type HardwareType = enum {
    ETHERNET = 1,
};

# DHCP Option codes
type OptionCode = enum {
    PAD = 0,
    SUBNET_MASK = 1,
    TIME_OFFSET = 2,
    ROUTER = 3,
    TIME_SERVER = 4,
    NAME_SERVER = 5,
    DNS_SERVER = 6,
    LOG_SERVER = 7,
    COOKIE_SERVER = 8,
    LPR_SERVER = 9,
    IMPRESS_SERVER = 10,
    RESOURCE_LOCATION_SERVER = 11,
    HOST_NAME = 12,
    BOOT_FILE_SIZE = 13,
    MERIT_DUMP_FILE = 14,
    DOMAIN_NAME = 15,
    SWAP_SERVER = 16,
    ROOT_PATH = 17,
    EXTENSIONS_PATH = 18,
    IP_FORWARDING = 19,
    NON_LOCAL_SOURCE_ROUTING = 20,
    POLICY_FILTER = 21,
    MAX_DATAGRAM_REASSEMBLY = 22,
    DEFAULT_IP_TTL = 23,
    PATH_MTU_AGING_TIMEOUT = 24,
    PATH_MTU_PLATEAU_TABLE = 25,
    INTERFACE_MTU = 26,
    ALL_SUBNETS_LOCAL = 27,
    BROADCAST_ADDRESS = 28,
    PERFORM_MASK_DISCOVERY = 29,
    MASK_SUPPLIER = 30,
    PERFORM_ROUTER_DISCOVERY = 31,
    ROUTER_SOLICITATION_ADDRESS = 32,
    STATIC_ROUTE = 33,
    TRAILER_ENCAPSULATION = 34,
    ARP_CACHE_TIMEOUT = 35,
    ETHERNET_ENCAPSULATION = 36,
    TCP_DEFAULT_TTL = 37,
    TCP_KEEPALIVE_INTERVAL = 38,
    TCP_KEEPALIVE_GARBAGE = 39,
    NIS_DOMAIN = 40,
    NIS_SERVERS = 41,
    NTP_SERVERS = 42,
    VENDOR_SPECIFIC = 43,
    NETBIOS_NAME_SERVER = 44,
    NETBIOS_DD_SERVER = 45,
    NETBIOS_NODE_TYPE = 46,
    NETBIOS_SCOPE = 47,
    X_WINDOW_FONT_SERVER = 48,
    X_WINDOW_DISPLAY_MANAGER = 49,
    REQUESTED_IP_ADDRESS = 50,
    IP_ADDRESS_LEASE_TIME = 51,
    OPTION_OVERLOAD = 52,
    DHCP_MESSAGE_TYPE = 53,
    SERVER_IDENTIFIER = 54,
    PARAMETER_REQUEST_LIST = 55,
    MESSAGE = 56,
    MAX_DHCP_MESSAGE_SIZE = 57,
    RENEWAL_TIME_T1 = 58,
    REBINDING_TIME_T2 = 59,
    VENDOR_CLASS_IDENTIFIER = 60,
    CLIENT_IDENTIFIER = 61,
    END = 255,
};

# DHCP Option with tag-length-value encoding
type DHCPOption = unit {
    code: uint8 &convert=OptionCode($$);
    switch ( self.code ) {
        OptionCode::PAD -> : void;
        OptionCode::END -> : void;
        * -> {
            len: uint8;
            switch ( self.code ) {
                OptionCode::DHCP_MESSAGE_TYPE -> msg_type: uint8 &convert=MessageType($$);
                OptionCode::REQUESTED_IP_ADDRESS -> requested_ip: addr &ipv4;
                OptionCode::SERVER_IDENTIFIER -> server_id: addr &ipv4;
                OptionCode::IP_ADDRESS_LEASE_TIME -> lease_time: uint32 &convert=cast<interval>($$);
                OptionCode::SUBNET_MASK -> subnet_mask: addr &ipv4;
                OptionCode::ROUTER -> router_data: bytes &size=self.len;
                OptionCode::DNS_SERVER -> dns_data: bytes &size=self.len;
                OptionCode::BROADCAST_ADDRESS -> broadcast_addr: addr &ipv4;
                OptionCode::RENEWAL_TIME_T1 -> t1_time: uint32 &convert=cast<interval>($$);
                OptionCode::REBINDING_TIME_T2 -> t2_time: uint32 &convert=cast<interval>($$);
                OptionCode::MAX_DHCP_MESSAGE_SIZE -> max_msg_size: uint16;
                OptionCode::OPTION_OVERLOAD -> overload: uint8;
                OptionCode::PARAMETER_REQUEST_LIST -> param_list: uint8[self.len];
                OptionCode::CLIENT_IDENTIFIER -> client_id: bytes &size=self.len;
                OptionCode::VENDOR_CLASS_IDENTIFIER -> vendor_class: bytes &size=self.len;
                OptionCode::MESSAGE -> message: bytes &size=self.len;
                OptionCode::HOST_NAME -> hostname: bytes &size=self.len;
                OptionCode::DOMAIN_NAME -> domain_name: bytes &size=self.len;
                OptionCode::DEFAULT_IP_TTL -> default_ttl: uint8;
                OptionCode::TCP_DEFAULT_TTL -> tcp_ttl: uint8;
                OptionCode::IP_FORWARDING -> ip_forwarding: uint8;
                OptionCode::NON_LOCAL_SOURCE_ROUTING -> non_local_src_routing: uint8;
                OptionCode::INTERFACE_MTU -> interface_mtu: uint16;
                OptionCode::ALL_SUBNETS_LOCAL -> all_subnets_local: uint8;
                OptionCode::PERFORM_MASK_DISCOVERY -> mask_discovery: uint8;
                OptionCode::MASK_SUPPLIER -> mask_supplier: uint8;
                OptionCode::PERFORM_ROUTER_DISCOVERY -> router_discovery: uint8;
                OptionCode::ROUTER_SOLICITATION_ADDRESS -> router_sol_addr: addr &ipv4;
                OptionCode::STATIC_ROUTE -> static_route_data: bytes &size=self.len;
                OptionCode::TRAILER_ENCAPSULATION -> trailer_encap: uint8;
                OptionCode::ARP_CACHE_TIMEOUT -> arp_cache_timeout: uint32 &convert=cast<interval>($$);
                OptionCode::ETHERNET_ENCAPSULATION -> ether_encap: uint8;
                OptionCode::TCP_KEEPALIVE_INTERVAL -> keepalive_interval: uint32 &convert=cast<interval>($$);
                OptionCode::TCP_KEEPALIVE_GARBAGE -> keepalive_garbage: uint8;
                OptionCode::MAX_DATAGRAM_REASSEMBLY -> max_reassembly: uint16;
                OptionCode::PATH_MTU_AGING_TIMEOUT -> pmtu_aging_timeout: uint32 &convert=cast<interval>($$);
                OptionCode::PATH_MTU_PLATEAU_TABLE -> pmtu_plateau_data: bytes &size=self.len;
                OptionCode::POLICY_FILTER -> policy_filter_data: bytes &size=self.len;
                OptionCode::BOOT_FILE_SIZE -> boot_file_size: uint16;
                OptionCode::SWAP_SERVER -> swap_server: addr &ipv4;
                OptionCode::TIME_OFFSET -> time_offset: int32;
                OptionCode::TIME_SERVER -> time_server_data: bytes &size=self.len;
                OptionCode::NAME_SERVER -> name_server_data: bytes &size=self.len;
                OptionCode::LOG_SERVER -> log_server_data: bytes &size=self.len;
                OptionCode::COOKIE_SERVER -> cookie_server_data: bytes &size=self.len;
                OptionCode::LPR_SERVER -> lpr_server_data: bytes &size=self.len;
                OptionCode::IMPRESS_SERVER -> impress_server_data: bytes &size=self.len;
                OptionCode::RESOURCE_LOCATION_SERVER -> rlp_server_data: bytes &size=self.len;
                OptionCode::MERIT_DUMP_FILE -> merit_dump: bytes &size=self.len;
                OptionCode::ROOT_PATH -> root_path: bytes &size=self.len;
                OptionCode::EXTENSIONS_PATH -> extensions_path: bytes &size=self.len;
                OptionCode::NIS_DOMAIN -> nis_domain: bytes &size=self.len;
                OptionCode::NIS_SERVERS -> nis_servers_data: bytes &size=self.len;
                OptionCode::NTP_SERVERS -> ntp_servers_data: bytes &size=self.len;
                OptionCode::VENDOR_SPECIFIC -> vendor_specific_data: bytes &size=self.len;
                OptionCode::NETBIOS_NAME_SERVER -> netbios_ns_data: bytes &size=self.len;
                OptionCode::NETBIOS_DD_SERVER -> netbios_dd_data: bytes &size=self.len;
                OptionCode::NETBIOS_NODE_TYPE -> netbios_node_type: uint8;
                OptionCode::NETBIOS_SCOPE -> netbios_scope: bytes &size=self.len;
                OptionCode::X_WINDOW_FONT_SERVER -> xfont_server_data: bytes &size=self.len;
                OptionCode::X_WINDOW_DISPLAY_MANAGER -> xdm_data: bytes &size=self.len;
                * -> data: bytes &size=self.len;
            };
        };
    };
};

# Flags bitfield (16 bits)
type Flags = unit {
    f: bitfield(16) {
        broadcast: 15;
        mbz: 0..14;
    };
};

# Magic cookie: 99.130.83.99
const MagicCookie = b"\x63\x82\x53\x63";

# Main DHCP message
public type DHCPMessage = unit {
    # Fixed-length fields
    op: uint8 &convert=OpCode($$);
    htype: uint8;
    hlen: uint8;
    hops: uint8;
    xid: uint32;
    secs: uint16;
    flags: Flags;
    ciaddr: addr &ipv4;
    yiaddr: addr &ipv4;
    siaddr: addr &ipv4;
    giaddr: addr &ipv4;
    chaddr: bytes &size=16;
    sname: bytes &size=64 &convert=$$.split1(b"\0")[0].decode();
    filename: bytes &size=128 &convert=$$.split1(b"\0")[0].decode();

    # Options field: starts with magic cookie, then TLV options
    magic: MagicCookie;
    options: DHCPOption[] &eod;
};