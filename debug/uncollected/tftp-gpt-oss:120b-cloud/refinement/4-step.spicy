module TFTP;

type Opcode = enum {
  RRQ = 1,
  WRQ = 2,
  DATA = 3,
  ACK = 4,
  ERROR = 5,
};

type ErrorCode = enum {
  NotDefined = 0,
  FileNotFound = 1,
  AccessViolation = 2,
  DiskFull = 3,
  IllegalOperation = 4,
  UnknownTID = 5,
  FileExists = 6,
  NoSuchUser = 7,
};

# Request packet (RRQ/WRQ) fields
type Request = unit {
  filename: bytes &until=b"\0" &convert=$$.split1(b"\0")[0].decode();
  mode: bytes &until=b"\0" &convert=$$.split1(b"\0")[0].decode();
};

type Data = unit {
  block: uint16;
  data: bytes &eod; // up to 512 bytes, actual length determined by UDP payload size
};

type Ack = unit {
  block: uint16;
};

type Error = unit {
  errcode: uint16 &convert=ErrorCode($$);
  errmsg: bytes &until=b"\0" &convert=$$.split1(b"\0")[0].decode();
};

public type TftpPacket = unit {
  opcode: uint16 &convert=Opcode($$);
  switch (self.opcode) {
    Opcode::RRQ -> rrq: Request;
    Opcode::WRQ -> wrq: Request;
    Opcode::DATA -> data: Data;
    Opcode::ACK -> ack: Ack;
    Opcode::ERROR -> err: Error;
    * -> : void;
  };
};