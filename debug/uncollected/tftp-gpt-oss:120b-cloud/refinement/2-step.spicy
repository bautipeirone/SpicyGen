module TFTP;

    type Opcode = enum {
        RRQ = 1,
        WRQ = 2,
        DATA = 3,
        ACK = 4,
        ERROR = 5,
    };

    type Request = unit {
        filename: bytes &until=b"\0" &convert=$$.split1(b"\0")[0].decode();
        mode: bytes &until=b"\0" &convert=$$.split1(b"\0")[0].decode();
    };

    type Data = unit {
        block: uint16;
        data: bytes &eod;
    };

    type Ack = unit {
        block: uint16;
    };

    type Error = unit {
        errorcode: uint16;
        errmsg: bytes &until=b"\0" &convert=$$.split1(b"\0")[0].decode();
    };

    public type TFTP = unit {
        opcode: uint16 &convert=Opcode($$);
        switch (self.opcode) {
            Opcode::RRQ,
            Opcode::WRQ -> request: Request;
            Opcode::DATA -> data: Data;
            Opcode::ACK -> ack: Ack;
            Opcode::ERROR -> error: Error;
            * -> : void;
        };
    };