module DHCP;

public type MessageType = enum {
    DHCPDISCOVER = 1,
    DHCPOFFER    = 2,
    DHCPREQUEST  = 3,
    DHCPDECLINE  = 4,
    DHCPACK      = 5,
    DHCPNAK      = 6,
    DHCPRELEASE  = 7,
    DHCPINFORM   = 8,
};

type OpCode = enum {
    BOOTREQUEST = 1,
    BOOTREPLY   = 2,
};

type HwType = enum {
    ETHERNET = 1,
};

const MagicCookie = b"\x63\x82\x53\x63";

public type Packet = unit {
    op: uint8 &convert=OpCode($$);
    htype: uint8 &convert=HwType($$);
    hlen: uint8;
    hops: uint8;
    xid: uint32;
    secs: uint16;
    flags: uint16;
    ciaddr: addr &ipv4;
    yiaddr: addr &ipv4;
    siaddr: addr &ipv4;
    giaddr: addr &ipv4;
    chaddr: bytes &size=16;
    sname: bytes &size=64 &convert=$$.split1(b"\0")[0].decode();
    file: bytes &size=128 &convert=$$.split1(b"\0")[0].decode();
    options: Options;
};

type Options = unit {
    magic: bytes &size=4 &requires=$$ == MagicCookie;
    opts: DhcpOption[];
    : b"\xff"; # End option
};

type DhcpOption = unit {
    code: uint8;
    len: uint8;
    switch ( self.code ) {
        1 -> subnet_mask: addr &ipv4 &size=self.len;
        3 -> routers: addr[self.len/4] &ipv4;
        6 -> dns_servers: addr[self.len/4] &ipv4;
        12 -> hostname: bytes &size=self.len &convert=$$.decode();
        15 -> domain_name: bytes &size=self.len &convert=$$.decode();
        28 -> broadcast_addr: addr &ipv4 &size=self.len;
        44 -> netbios_ns: addr[self.len/4] &ipv4;
        50 -> req_ip: addr &ipv4 &size=self.len;
        51 -> lease_time: uint32 &size=self.len &convert=cast<interval>($$);
        53 -> msg_type: uint8 &size=self.len &convert=MessageType($$);
        54 -> server_id: addr &ipv4 &size=self.len;
        55 -> param_req_list: uint8[self.len];
        57 -> max_msg_size: uint16 &size=self.len;
        58 -> t1: uint32 &size=self.len &convert=cast<interval>($$);
        59 -> t2: uint32 &size=self.len &convert=cast<interval>($$);
        60 -> vendor_class_id: bytes &size=self.len &convert=$$.decode();
        61 -> client_id: bytes &size=self.len;
        81 -> fqdn: bytes &size=self.len &convert=$$.decode();
        * -> : bytes &size=self.len; # Unknown option
    };
};