module DHCP;

type MessageOp = enum {
    BOOTREQUEST = 1,
    BOOTREPLY   = 2,
};

type DHCPMessage = unit {
    op     : uint8 &convert=MessageOp($$);
    htype  : uint8;
    hlen   : uint8;
    hops   : uint8;
    xid    : uint32;
    secs   : uint16;
    flags  : bitfield(16) {
        broadcast : 15;
        mbz       : 0..14;
    };
    ciaddr : addr &ipv4;
    yiaddr : addr &ipv4;
    siaddr : addr &ipv4;
    giaddr : addr &ipv4;
    chaddr : bytes &size=16;
    sname  : bytes &size=64  &convert=$$.split1(b"\x00")[0].decode();
    filename : bytes &size=128 &convert=$$.split1(b"\x00")[0].decode();
    magic_cookie : bytes &size=4 &requires=($$ == b"\x63\x82\x53\x63");
    options : DHCPOption[] &eod;
};

type DHCPMessageType = enum {
    DHCPDISCOVER = 1,
    DHCPOFFER    = 2,
    DHCPREQUEST  = 3,
    DHCPDECLINE  = 4,
    DHCPACK      = 5,
    DHCPNAK      = 6,
    DHCPRELEASE  = 7,
    DHCPINFORM   = 8,
};

type DHCPOption = unit {
    code : uint8;
    switch ( self.code ) {
        0   -> : void;           # Pad option
        255 -> : void;           # End option
        *   -> body : DHCPOptionBody(self.code);
    };
};

type DHCPOptionBody = unit(code: uint8) {
    length : uint8;
    switch ( code ) {
        # Subnet Mask (1)
        1   -> subnet_mask          : addr &ipv4;
        # Time Offset (2)
        2   -> time_offset          : int32;
        # Router (3)
        3   -> routers              : addr &ipv4 [self.length / 4];
        # Time Server (4)
        4   -> time_servers         : addr &ipv4 [self.length / 4];
        # Name Server (5)
        5   -> name_servers         : addr &ipv4 [self.length / 4];
        # Domain Name Server (6)
        6   -> dns_servers          : addr &ipv4 [self.length / 4];
        # Log Server (7)
        7   -> log_servers          : addr &ipv4 [self.length / 4];
        # Cookie Server (8)
        8   -> cookie_servers       : addr &ipv4 [self.length / 4];
        # LPR Server (9)
        9   -> lpr_servers          : addr &ipv4 [self.length / 4];
        # Impress Server (10)
        10  -> impress_servers      : addr &ipv4 [self.length / 4];
        # Resource Location Server (11)
        11  -> rlp_servers          : addr &ipv4 [self.length / 4];
        # Host Name (12)
        12  -> host_name            : bytes &size=self.length &convert=$$.decode();
        # Boot File Size (13)
        13  -> boot_file_size       : uint16;
        # Merit Dump File (14)
        14  -> merit_dump_file      : bytes &size=self.length &convert=$$.decode();
        # Domain Name (15)
        15  -> domain_name          : bytes &size=self.length &convert=$$.decode();
        # Swap Server (16)
        16  -> swap_server          : addr &ipv4;
        # Root Path (17)
        17  -> root_path            : bytes &size=self.length &convert=$$.decode();
        # Extensions Path (18)
        18  -> extensions_path      : bytes &size=self.length &convert=$$.decode();
        # IP Forwarding (19)
        19  -> ip_forwarding        : uint8;
        # Non-Local Source Routing (20)
        20  -> non_local_src_routing: uint8;
        # Max Datagram Reassembly Size (22)
        22  -> max_dgram_reassembly : uint16;
        # Default IP TTL (23)
        23  -> default_ip_ttl       : uint8;
        # Interface MTU (26)
        26  -> interface_mtu        : uint16;
        # Broadcast Address (28)
        28  -> broadcast_address    : addr &ipv4;
        # Requested IP Address (50)
        50  -> requested_ip         : addr &ipv4;
        # IP Address Lease Time (51)
        51  -> lease_time           : uint32 &convert=cast<interval>($$);
        # Option Overload (52)
        52  -> option_overload      : uint8 &requires=($$ == 1 || $$ == 2 || $$ == 3);
        # DHCP Message Type (53)
        53  -> dhcp_msg_type        : uint8 &convert=DHCPMessageType($$);
        # Server Identifier (54)
        54  -> server_id            : addr &ipv4;
        # Parameter Request List (55)
        55  -> param_request_list   : uint8[self.length];
        # Message (56)
        56  -> message              : bytes &size=self.length &convert=$$.decode();
        # Maximum DHCP Message Size (57)
        57  -> max_dhcp_msg_size    : uint16;
        # Renewal (T1) Time Value (58)
        58  -> renewal_time         : uint32 &convert=cast<interval>($$);
        # Rebinding (T2) Time Value (59)
        59  -> rebinding_time       : uint32 &convert=cast<interval>($$);
        # Vendor Class Identifier (60)
        60  -> vendor_class_id      : bytes &size=self.length;
        # Client Identifier (61)
        61  -> client_id            : ClientIdentifier(self.length);
        *   -> data                 : bytes &size=self.length;
    };
};

type ClientIdentifier = unit(len: uint8) {
    type_value : uint8;
    data       : bytes &size=(len - 1);
};

public type DHCP = unit {
    msg : DHCPMessage;
};