module BundleProtocol;

# Bundle Protocol Version 7 (RFC 9171)

# Fundamental Data Structures
type DTNTime = uint;

type CRC = unit {
    value: bytes &size=self.size;
    var size: uint;
};

type EndpointID = unit {
    uri_code: uint;
    switch (self.uri_code) {
        1 -> dtn_ssp: bytes &convert=$$.decode(); # dtn scheme
        2 -> ipn_ssp: [uint, uint];               # ipn scheme
        * -> ssp: bytes;
    };
};

type CreationTimestamp = unit {
    creation_time: DTNTime;
    sequence_number: uint;
};

# Blocks
type PrimaryBlock = unit {
    version: uint &requires=($$ == 7);
    bundle_control_flags: uint;
    crc_type: uint;
    destination: EndpointID;
    source_node: EndpointID;
    report_to: EndpointID;
    creation_timestamp: CreationTimestamp;
    lifetime: uint;
    
    # Conditional fields based on flags
    # Bit 0: Bundle is a fragment
    fragment_offset: uint if (self.bundle_control_flags & 0x01);
    total_adu_length: uint if (self.bundle_control_flags & 0x01);
    
    crc: CRC(self.crc_type) if (self.crc_type != 0);
};

type CanonicalBlock = unit {
    block_type_code: uint;
    block_number: uint;
    block_control_flags: uint;
    crc_type: uint;
    block_type_specific_data: bytes;
    crc: CRC(self.crc_type) if (self.crc_type != 0);
};

# Administrative Records
type StatusReport = unit {
    # Simplified representation of the status report content
    status_info: bytes; 
    reason_code: uint;
    source_node_eid: EndpointID;
    creation_timestamp: CreationTimestamp;
    fragment_offset: uint;
    fragment_length: uint;
};

# Main Bundle Structure
public type Bundle = unit {
    # Bundles are represented as a CBOR indefinite-length array
    # The primary block is the first item
    primary: PrimaryBlock;
    
    # Followed by one or more canonical blocks
    blocks: CanonicalBlock[];
    
    # The bundle ends with a payload block (type 1) and a break code
    # This is handled by the parser logic
};