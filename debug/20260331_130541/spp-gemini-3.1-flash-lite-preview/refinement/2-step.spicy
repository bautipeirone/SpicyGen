module CCSDS_SPP;

# Space Packet Protocol (CCSDS 133.0-B-2)

# The Packet Primary Header is 6 octets (48 bits)
# Packet Version Number: 3 bits
# Packet Identification Field: 13 bits (Type: 1, SecHdrFlag: 1, APID: 11)
# Packet Sequence Control Field: 16 bits (SeqFlags: 2, SeqCount/Name: 14)
# Packet Data Length: 16 bits

public type SpacePacket = unit {
    # Packet Primary Header
    header: bitfield(48) {
        version_number: 0..2;
        packet_type: 3;
        secondary_header_flag: 4;
        apid: 5..15;
        sequence_flags: 16..17;
        packet_sequence_count_or_name: 18..31;
        packet_data_length: 32..47;
    };

    # Packet Data Field
    # The length of the Packet Data Field is (packet_data_length + 1)
    packet_data_field: bytes &size=(self.header.packet_data_length + 1);
};