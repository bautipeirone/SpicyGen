module IP;

type Option = unit {
    type_val: uint8;
    switch (self.type_val) {
        0 -> : void; # End of Option list
        1 -> : void; # No Operation
        * -> {
            len: uint8;
            data: bytes &size=self.len - 2;
        }
    };
};

public type Datagram = unit {
    version: uint4;
    ihl: uint4;
    tos: uint8;
    total_length: uint16;
    id: uint16;
    flags: bitfield(3) {
        reserved: 0;
        df: 1;
        mf: 2;
    };
    fragment_offset: uint13;
    ttl: uint8;
    protocol: uint8;
    checksum: uint16;
    src: addr &ipv4;
    dst: addr &ipv4;
    
    # Options are present if IHL > 5. IHL is in 32-bit words.
    # Header length in bytes is IHL * 4.
    # Options start after the 20-byte fixed header.
    options: Option[] &size=(self.ihl - 5) * 4;
    
    # Data follows the header
    data: bytes &eod;
};