module IP;

public type Datagram = unit {
    header: Header;
    data: bytes &eod;
};

type Header = unit {
    version_ihl: uint8;
    type_of_service: uint8;
    total_length: uint16;
    identification: uint16;
    flags_fragment_offset: uint16;
    ttl: uint8;
    protocol: uint8;
    checksum: uint16;
    source_address: addr &ipv4;
    destination_address: addr &ipv4;
    options: Option[] &size=(self.ihl * 4 - 20) if(self.ihl > 5);
    padding: bytes &size=((4 - (self.ihl * 4) % 4) % 4) if(self.ihl > 5);
} &let version = $$ >> 4
  &let ihl = $$ & 0x0F;