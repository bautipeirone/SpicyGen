module TCP;

public type Header = unit {
    src_port: uint16;
    dst_port: uint16;
    seq_num: uint32;
    ack_num: uint32;
    
    # Data Offset (4 bits), Reserved (6 bits), Control Bits (6 bits)
    # Total 16 bits.
    # Using bitfield(16) and standard bit order.
    # The RFC says:
    # Data Offset: 4 bits
    # Reserved: 6 bits
    # Control Bits: 6 bits
    # Total: 16 bits.
    
    control: bitfield(16) {
        data_offset: 0..3;
        reserved: 4..9;
        urg: 10;
        ack: 11;
        psh: 12;
        rst: 13;
        syn: 14;
        fin: 15;
    };
    
    window: uint16;
    checksum: uint16;
    urgent_pointer: uint16;
    
    # Options and Padding
    # The header length is in 32-bit words.
    # Header length = data_offset * 4 bytes.
    # We have already read 20 bytes (src_port, dst_port, seq_num, ack_num, control, window, checksum, urgent_pointer).
    # Wait, 2+2+4+4+2+2+2+2 = 20 bytes. Correct.
    
    options_and_padding: bytes &size=(self.control.data_offset * 4 - 20);
    
    data: bytes &eod;
};