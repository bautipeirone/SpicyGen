module TCP;

type Option = unit {
    kind: uint8;
    switch (self.kind) {
        0 -> : void;
        1 -> : void;
        2 -> {
            len: uint8 &requires=($$ == 4);
            max_seg_size: uint16;
        };
        * -> {
            len: uint8;
            data: bytes &size=(self.len - 2);
        };
    };
};

public type Header = unit {
    src_port: uint16;
    dst_port: uint16;
    seq_num: uint32;
    ack_num: uint32;
    data_offset: uint8 &bit-order=spicy::BitOrder::MSB0 &size=4;
    reserved: uint8 &bit-order=spicy::BitOrder::MSB0 &size=6;
    urg: uint8 &bit-order=spicy::BitOrder::MSB0 &size=1;
    ack: uint8 &bit-order=spicy::BitOrder::MSB0 &size=1;
    psh: uint8 &bit-order=spicy::BitOrder::MSB0 &size=1;
    rst: uint8 &bit-order=spicy::BitOrder::MSB0 &size=1;
    syn: uint8 &bit-order=spicy::BitOrder::MSB0 &size=1;
    fin: uint8 &bit-order=spicy::BitOrder::MSB0 &size=1;
    window: uint16;
    checksum: uint16;
    urgent_pointer: uint16;
    
    # Data offset is in 32-bit words. Header is at least 5 words (20 bytes).
    # Options start after the 20th byte.
    : bytes &size=((self.data_offset * 4) - 20);
    
    data: bytes &eod;
};