module CCSDS_SPP;

# Space Packet Protocol (CCSDS 133.0-B-2)

public type SpacePacket = unit {
    # Packet Primary Header (6 octets)
    version: bitfield(3) {
        pvn: 0..2;
    };
    identification: bitfield(13) {
        packet_type: 0;
        secondary_header_flag: 1;
        apid: 2..12;
    };
    sequence_control: bitfield(16) {
        sequence_flags: 0..1;
        packet_sequence_count_or_name: 2..15;
    };
    packet_data_length: uint16;

    # Packet Data Field (1 to 65536 octets)
    # The length of the Packet Data Field is (packet_data_length + 1)
    data_field: bytes &size=(self.packet_data_length + 1);
};

# Subunit for the Packet Data Field
type PacketDataField = unit(has_secondary_header: bool) {
    secondary_header: PacketSecondaryHeader if (has_secondary_header);
    user_data: bytes &eod;
};

type PacketSecondaryHeader = unit {
    # The structure is mission-specific, but can contain Time Code and/or Ancillary Data
    # This is a placeholder as the actual structure is managed.
    data: bytes &eod;
};