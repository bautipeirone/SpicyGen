module CCSDS_SPP;

# Space Packet Protocol (CCSDS 133.0-B-2)
# Packet Primary Header is 6 octets (48 bits)

public type SpacePacket = unit {
    # Packet Primary Header (6 octets)
    # Bits 0-2: Version (3 bits)
    # Bits 3-15: Identification (13 bits)
    # Bits 16-31: Sequence Control (16 bits)
    # Bits 32-47: Data Length (16 bits)
    
    # We parse the 6-octet header as a 48-bit bitfield to handle the non-byte-aligned fields.
    header: bitfield(48) {
        version: 0..2;
        packet_type: 3;
        secondary_header_flag: 4;
        apid: 5..15;
        sequence_flags: 16..17;
        packet_sequence_count_or_name: 18..31;
        packet_data_length: 32..47;
    };

    # Packet Data Field (1 to 65536 octets)
    # The length of the Packet Data Field is (packet_data_length + 1)
    data_field: bytes &size=(self.header.packet_data_length + 1);
};