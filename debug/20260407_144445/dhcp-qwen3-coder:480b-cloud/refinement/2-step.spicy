module DHCP;

public type DhcpMessage = unit {
    op: uint8 &convert=MessageType($$);
    htype: uint8;
    hlen: uint8;
    hops: uint8;
    xid: uint32;
    secs: uint16;
    flags: uint16;
    ciaddr: addr &ipv4;
    yiaddr: addr &ipv4;
    siaddr: addr &ipv4;
    giaddr: addr &ipv4;
    chaddr: bytes &size=16;
    sname: bytes &size=64;
    filename: bytes &size=128;
    options: DhcpOptions;
};

type MessageType = enum {
    BOOTREQUEST = 1,
    BOOTREPLY = 2,
};

# Magic cookie for DHCP options: 99, 130, 83, 99
type DhcpOptions = unit {
    : uint32 &requires=($$ == 0x63825363);  # Magic cookie
    options: Option[] &eod;
};

type Option = unit {
    tag: uint8 &convert=OptionType($$);
    len: uint8 if (self.tag != OptionType::END && self.tag != OptionType::PAD);
    data: bytes &size=self.len if (self.tag != OptionType::END && self.tag != OptionType::PAD);
};

type OptionType = enum {
    PAD = 0,
    SUBNET_MASK = 1,
    TIME_OFFSET = 2,
    ROUTER = 3,
    TIME_SERVER = 4,
    NAME_SERVER = 5,
    DOMAIN_NAME_SERVER = 6,
    LOG_SERVER = 7,
    COOKIE_SERVER = 8,
    LPR_SERVER = 9,
    IMPRESS_SERVER = 10,
    RESOURCE_LOCATION_SERVER = 11,
    HOST_NAME = 12,
    BOOT_FILE_SIZE = 13,
    MERIT_DUMP_FILE = 14,
    DOMAIN_NAME = 15,
    SWAP_SERVER = 16,
    ROOT_PATH = 17,
    EXTENSIONS_PATH = 18,
    IP_FORWARDING = 19,
