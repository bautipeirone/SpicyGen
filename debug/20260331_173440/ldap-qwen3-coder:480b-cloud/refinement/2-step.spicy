module LDAP;

const MAXINT = 2147483647;

type MessageID = uint32;

type LDAPString = bytes;

type LDAPOID = LDAPString;

type LDAPDN = LDAPString;

type RelativeLDAPDN = LDAPString;

type AttributeDescription = LDAPString;

type AttributeValue = bytes;

type AssertionValue = bytes;

type AttributeValueAssertion = unit {
    attributeDesc: AttributeDescription;
    assertionValue: AssertionValue;
};

type PartialAttribute = unit {
    type: AttributeDescription;
    vals: AttributeValue[];
};

type Attribute = unit {
    type: AttributeDescription;
    vals: AttributeValue[];
};

type MatchingRuleId = LDAPString;

type LDAPResultCode = enum {
    success = 0,
    operationsError = 1,
    protocolError = 2,
    timeLimitExceeded = 3,
    sizeLimitExceeded = 4,
    compareFalse = 5,
    compareTrue = 6,
    authMethodNotSupported = 7,
    strongerAuthRequired = 8,
    referral = 10,
    adminLimitExceeded = 11,
    unavailableCriticalExtension = 12,
    confidentialityRequired = 13,
    saslBindInProgress = 14,
    noSuchAttribute = 16,
    undefinedAttributeType = 17,
    inappropriateMatching = 18,
    constraintViolation = 19,
    attributeOrValueExists = 20,
    invalidAttributeSyntax = 21,
    noSuchObject = 32,
    aliasProblem = 33,
    invalidDNSyntax = 34,
    aliasDereferencingProblem = 36,
    inappropriateAuthentication = 48,
    invalidCredentials = 49,
    insufficientAccessRights = 50,
    busy = 51,
    unavailable = 52,
    unwillingToPerform = 53,
    loopDetect = 54,
    namingViolation = 64,
    objectClassViolation = 65,
    notAllowedOnNonLeaf = 66,
    notAllowedOnRDN = 67,
    entryAlreadyExists = 68,
    objectClassModsProhibited = 69,
    affectsMultipleDSAs = 71,
    other = 80,
};

type LDAPResult = unit {
    resultCode: LDAPResultCode;
    matchedDN: LDAPDN;
    diagnosticMessage: LDAPString;
    referral: LDAPString[] &optional;
};

type Referral = unit {
    uris: LDAPString[];
};

type Control = unit {
    controlType: LDAPOID;
    criticality: uint8 &convert=cast<bool>($$);
    controlValue: bytes &optional;
};

type Controls = unit {
    controls: Control[];
};

type BindRequest = unit {
    version: uint8;
    name: LDAPDN;
    authentication: bytes;
};

type BindResponse = unit {
    resultCode: LDAPResultCode;
    matchedDN: LDAPDN;
    diagnosticMessage: LDAPString;
    serverSaslCreds: bytes &optional;
};

type UnbindRequest = unit {
    : void;
};

type SearchScope = enum {
    baseObject = 0,
    singleLevel = 1,
    wholeSubtree = 2,
};

type DerefAliases = enum {
    neverDerefAliases = 0,
    derefInSearching = 1,
    derefFindingBaseObj = 2,
    derefAlways = 3,
};

type Filter = unit {
    filterBytes: bytes &eod;
};

type AttributeSelection = unit {
    selectors: LDAPString[];
};

type SearchRequest = unit {
    baseObject: LDAPDN;
    scope: SearchScope;
    derefAliases: DerefAliases;
    sizeLimit: uint32;
    timeLimit: uint32;
    typesOnly: uint8 &convert=cast<bool>($$);
    filter: Filter;
    attributes: AttributeSelection;
};

type SearchResultEntry = unit {
    objectName: LDAPDN;
    attributes: PartialAttribute[];
};

type SearchResultReference = unit {
    uris: LDAPString[];
};

type SearchResultDone = unit {
    resultCode: LDAPResultCode;
    matchedDN: LDAPDN;
    diagnosticMessage: LDAPString;
    referral: LDAPString[] &optional;
};

type ModifyOperation = enum {
    add = 0,
    delete = 1,
    replace = 2,
};

type ModifyRequestChange = unit {
    operation: ModifyOperation;
    modification: PartialAttribute;
};

type ModifyRequest = unit {
    object: LDAPDN;
    changes: ModifyRequestChange[];
};

type ModifyResponse = unit {
    resultCode: LDAPResultCode;
    matchedDN: LDAPDN;
    diagnosticMessage: LDAPString;
    referral: LDAPString[] &optional;
};

type AddRequest = unit {
    entry: LDAPDN;
    attributes: Attribute[];
};

type AddResponse = unit {
    resultCode: LDAPResultCode;
    matchedDN: LDAPDN;
    diagnosticMessage: LDAPString;
    referral: LDAPString[] &optional;
};

type DelRequest = unit {
    entry: LDAPDN;
};

type DelResponse = unit {
    resultCode: LDAPResultCode;
    matchedDN: LDAPDN;
    diagnosticMessage: LDAPString;
    referral: LDAPString[] &optional;
};

type ModifyDNRequest = unit {
    entry: LDAPDN;
    newrdn: RelativeLDAPDN;
    deleteoldrdn: uint8 &convert=cast<bool>($$);
    newSuperior: LDAPDN &optional;
};

type ModifyDNResponse = unit {
    resultCode: LDAPResultCode;
    matchedDN: LDAPDN;
    diagnosticMessage: LDAPString;
    referral: LDAPString[] &optional;
};

type CompareRequest = unit {
    entry: LDAPDN;
    ava: AttributeValueAssertion;
};

type CompareResponse = unit {
    resultCode: LDAPResultCode;
    matchedDN: LDAPDN;
    diagnosticMessage: LDAPString;
    referral: LDAPString[] &optional;
};

type AbandonRequest = unit {
    messageID: MessageID;
};

type ExtendedRequest = unit {
    requestName: LDAPOID;
    requestValue: bytes &optional;
};

type ExtendedResponse = unit {
    resultCode: LDAPResultCode;
    matchedDN: LDAPDN;
    diagnosticMessage: LDAPString;
    referral: LDAPString[] &optional;
    responseName: LDAPOID &optional;
    responseValue: bytes &optional;
};

type IntermediateResponse = unit {
    responseName: LDAPOID &optional;
    responseValue: bytes &optional;
};

type ProtocolOp = unit {
    opType: uint8;
    data: bytes &eod;
};

public type LDAPMessage = unit {
    messageID: MessageID;
    protocolOp: ProtocolOp;
    controls: Controls &optional;
};