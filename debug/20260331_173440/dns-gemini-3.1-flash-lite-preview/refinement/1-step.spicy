module DNS;

type Label = unit {
    len: uint8;
    data: bytes &size=self.len;
};

type DomainName = unit {
    # This is a simplified representation of domain names, 
    # including compression pointers.
    # A full implementation would need to handle the recursive nature of labels/pointers.
    labels: bytes &until=b"\0";
};

type Header = unit {
    id: uint16;
    flags: bitfield(16) {
        qr: 0;
        opcode: 1..4;
        aa: 5;
        tc: 6;
        rd: 7;
        ra: 8;
        z: 9..11;
        rcode: 12..15;
    };
    qdcount: uint16;
    ancount: uint16;
    nscount: uint16;
    arcount: uint16;
};

type Question = unit {
    qname: DomainName;
    qtype: uint16;
    qclass: uint16;
};

type ResourceRecord = unit {
    name: DomainName;
    type_value: uint16;
    class_value: uint16;
    ttl: uint32;
    rdlength: uint16;
    rdata: bytes &size=self.rdlength;
};

public type Message = unit {
    header: Header;
    questions: Question[self.header.qdcount];
    answers: ResourceRecord[self.header.ancount];
    authorities: ResourceRecord[self.header.nscount];
    additionals: ResourceRecord[self.header.arcount];
};