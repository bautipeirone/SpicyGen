module DNS;

import spicy;

# DNS Header
public type DNSHeader = unit {
    id: uint16;
    flags: bitfield(16) {
        qr: 0;
        opcode: 1..4;
        aa: 5;
        tc: 6;
        rd: 7;
        ra: 8;
        z: 9..11;
        rcode: 12..15;
    };
    qdcount: uint16;
    ancount: uint16;
    nscount: uint16;
    arcount: uint16;
};

# Domain name compression handling
type DomainName = unit {
    labels: Label[] &eod;
};

type Label = unit {
    length: uint8;
    data: bytes &size=self.length if(self.length > 0 && self.length < 64);
    : void if(self.length == 0);
};

# QType values
type QType = enum {
    A = 1,
    NS = 2,
    MD = 3,
    MF = 4,
    CNAME = 5,
    SOA = 6,
    MB = 7,
    MG = 8,
    MR = 9,
    NULL = 10,
    WKS = 11,
    PTR = 12,
    HINFO = 13,
    MINFO = 14,
    MX = 15,
    TXT = 16,
    AXFR = 252,
    MAILB = 253,
    MAILA = 254,
    ANY = 255
};

# QClass values
type QClass = enum {
    IN = 1,
    CS = 2,
    CH = 3,
    HS = 4,
    ANY = 255
};

# Resource Record structure
type RR = unit {
    name: DomainName;
    type_value: uint16 &convert=QType($$);
    class_value: uint16 &convert=QClass($$);
    ttl: uint32;
    rdlength: uint16;
    rdata: bytes &size=self.rdlength;
};

# Question section
type Question = unit {
    qname: DomainName;
    qtype: uint16 &convert=QType($$);
    qclass: uint16 &convert=QClass($$);
};

# Complete DNS Message
public type DNSMessage = unit {
    header: DNSHeader;
    questions: Question[self.header.qdcount];
    answers: RR[self.header.ancount];
    authorities: RR[self.header.nscount];
    additionals: RR[self.header.arcount];
};