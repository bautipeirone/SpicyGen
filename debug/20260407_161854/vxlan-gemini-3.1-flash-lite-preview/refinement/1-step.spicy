module VXLAN;

# VXLAN Header
type VXLANHeader = unit {
    flags: bitfield(8) {
        r1: 0..2;
        i: 3;
        r2: 4..7;
    };
    reserved1: uint24;
    vni: uint24;
    reserved2: uint8;
};

# Inner Ethernet Frame
type InnerEthernetFrame = unit {
    dst_mac: bytes &size=6;
    src_mac: bytes &size=6;
    # Optional VLAN tag handling
    # The RFC mentions 802.1Q C-Tag
    vlan_tag: bitfield(32) if (self.peek(2) == b"\x81\x00") {
        ethertype: 0..15;
        vlan_info: 16..31;
    };
    ethertype: uint16;
    payload: bytes &eod;
};

# VXLAN Packet
public type VXLANPacket = unit {
    # The VXLAN header is 8 bytes
    vxlan_header: VXLANHeader;
    # The inner Ethernet frame follows
    inner_frame: InnerEthernetFrame;
};