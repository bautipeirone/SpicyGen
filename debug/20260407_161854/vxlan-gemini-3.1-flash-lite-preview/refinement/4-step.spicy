module VXLAN;

# VXLAN Header
type VXLANHeader = unit {
    flags: uint8;
    reserved1: uint8[3];
    vni_bytes: bytes &size=3;
    reserved2: uint8;
};

# Inner Ethernet Frame
type InnerEthernetFrame = unit {
    dst_mac: bytes &size=6;
    src_mac: bytes &size=6;
    
    # Check for VLAN tag (0x8100)
    # We can read the next 2 bytes and check them
    tag_check: uint16;
    
    switch (self.tag_check) {
        0x8100 -> {
            vlan_info: uint16;
            ethertype: uint16;
        }
        * -> {
            ethertype: uint16;
        }
    };
    
    payload: bytes &eod;
};

# VXLAN Packet
public type VXLANPacket = unit {
    vxlan_header: VXLANHeader;
    inner_frame: InnerEthernetFrame;
};