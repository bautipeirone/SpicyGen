module VXLAN;

# VXLAN Header
type VXLANHeader = unit {
    # Flags: 8 bits
    # I flag (bit 3) MUST be 1 for valid VNI
    # R bits (others) MUST be 0
    flags: uint8;
    
    # Reserved fields: 24 bits
    reserved1: uint8[3];
    
    # VNI: 24 bits
    # We can read 3 bytes and convert to uint32
    vni_bytes: bytes &size=3;
    
    # Reserved: 8 bits
    reserved2: uint8;
};

# Inner Ethernet Frame
type InnerEthernetFrame = unit {
    dst_mac: bytes &size=6;
    src_mac: bytes &size=6;
    
    # Handle optional VLAN tag (802.1Q)
    # If the next 2 bytes are 0x8100, it's a VLAN tag
    # We use a switch to handle the optional tag
    switch (self.peek(2)) {
        b"\x81\x00" -> {
            vlan_tag: uint32;
        }
        * -> {
            ethertype: uint16;
        }
    };
    
    payload: bytes &eod;
};

# VXLAN Packet
public type VXLANPacket = unit {
    vxlan_header: VXLANHeader;
    inner_frame: InnerEthernetFrame;
};