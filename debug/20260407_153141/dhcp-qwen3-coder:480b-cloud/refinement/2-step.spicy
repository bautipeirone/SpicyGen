module DHCP;

import spicy;

type MessageType = enum {
    BOOTREQUEST = 1,
    BOOTREPLY = 2,
};

type HwType = enum {
    ETHERNET = 1,
    # Other types can be added as needed
};

type DhcpOpCode = enum {
    DHCPDISCOVER = 1,
    DHCPOFFER = 2,
    DHCPREQUEST = 3,
    DHCPDECLINE = 4,
    DHCPACK = 5,
    DHCPNAK = 6,
    DHCPRELEASE = 7,
    DHCPINFORM = 8,
};

# DHCP header structure
public type DhcpHeader = unit {
    op: uint8 &convert=MessageType($$);
    htype: uint8 &convert=HwType($$);
    hlen: uint8;
    hops: uint8;
    xid: uint32;
    secs: uint16;
    flags: uint16;
    ciaddr: addr &ipv4;
    yiaddr: addr &ipv4;
    siaddr: addr &ipv4;
    giaddr: addr &ipv4;
    chaddr: bytes &size=16;
    sname: bytes &size=64 &convert=$$.split1(b"\0")[0].decode();
    filename: bytes &size=128 &convert=$$.split1(b"\0")[0].decode();
    options: DhcpOptions;
};

# DHCP Options
type DhcpOptions = unit {
    magic_cookie: bytes &size=4 &requires=($$ == b"\x63\x82\x53\x63");
    options: DhcpOption[];
    : b"\xff";  # End option
};

type DhcpOption = unit {
    code: uint8;
    length: uint8 &if(self.code != 0 && self.code != 255);
    data: bytes &size=self.length &if(self.code != 0 && self.code != 255);
    
    # Special handling for specific options
    switch (self.code) {
        53 -> opcode: uint8 &convert=DhcpOpCode($$);  # DHCP Message Type
        54 -> server_id: addr &ipv4 &if(self.length == 4);  # Server Identifier
        50 -> requested_ip: addr &ipv4 &if(self.length == 4);  # Requested IP Address
        * -> : void;
    };
};