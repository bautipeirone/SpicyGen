module BFD;

# BFD Control Packet Format (RFC 5880)

type AuthType = enum {
    Reserved = 0,
    SimplePassword = 1,
    KeyedMD5 = 2,
    MeticulousKeyedMD5 = 3,
    KeyedSHA1 = 4,
    MeticulousKeyedSHA1 = 5
};

type State = enum {
    AdminDown = 0,
    Down = 1,
    Init = 2,
    Up = 3
};

type AuthSection = unit {
    auth_type: uint8 &convert=AuthType($$);
    auth_len: uint8;
    
    switch (self.auth_type) {
        AuthType::SimplePassword -> {
            auth_key_id: uint8;
            password: bytes &size=(self.auth_len - 3);
        }
        AuthType::KeyedMD5, AuthType::MeticulousKeyedMD5 -> {
            auth_key_id: uint8;
            reserved: uint8;
            sequence_number: uint32;
            auth_key_digest: bytes &size=(self.auth_len - 8);
        }
        AuthType::KeyedSHA1, AuthType::MeticulousKeyedSHA1 -> {
            auth_key_id: uint8;
            reserved: uint8;
            sequence_number: uint32;
            auth_key_hash: bytes &size=(self.auth_len - 8);
        }
        * -> {
            data: bytes &size=(self.auth_len - 2);
        }
    };
};

public type BFDControlPacket = unit {
    # Mandatory Section
    vers_diag: bitfield(8) {
        vers: 0..2;
        diag: 3..7;
    };
    sta_flags: bitfield(8) {
        sta: 0..1;
        p: 2;
        f: 3;
        c: 4;
        a: 5;
        d: 6;
        m: 7;
    };
    detect_mult: uint8;
    length: uint8;
    my_discriminator: uint32;
    your_discriminator: uint32;
    desired_min_tx_interval: uint32;
    required_min_rx_interval: uint32;
    required_min_echo_rx_interval: uint32;
    
    # Optional Authentication Section
    auth: AuthSection if (self.sta_flags.a == 1);
};