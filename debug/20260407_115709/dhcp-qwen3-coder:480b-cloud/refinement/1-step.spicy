module dhcp;

public type Message = unit {
    op: uint8;
    htype: uint8;
    hlen: uint8;
    hops: uint8;
    xid: uint32;
    secs: uint16;
    flags: uint16;
    ciaddr: addr &ipv4;
    yiaddr: addr &ipv4;
    siaddr: addr &ipv4;
    giaddr: addr &ipv4;
    chaddr: bytes &size=16;
    sname: bytes &size=64 &convert=$$.split1(b"\0")[0].decode();
    file: bytes &size=128 &convert=$$.split1(b"\0")[0].decode();
    options: Option[];
};

type Option = unit {
    code: uint8;
    switch (self.code) {
        0 -> : void;  # Pad option
        255 -> : void;  # End option
        * -> length: uint8;
             data: bytes &size=self.length;
    };
};