module ICMP;

type Type = enum {
    EchoReply = 0,
    DestinationUnreachable = 3,
    SourceQuench = 4,
    Redirect = 5,
    Echo = 8,
    TimeExceeded = 11,
    ParameterProblem = 12,
    Timestamp = 13,
    TimestampReply = 14,
    InformationRequest = 15,
    InformationReply = 16
};

type Code = uint8;

type ICMPHeader = unit {
    type_val: uint8 &convert=Type($$);
    code: Code;
    checksum: uint16;
};

type OriginalDatagram = unit {
    data: bytes &eod;
};

public type ICMPMessage = unit {
    header: ICMPHeader;
    switch (self.header.type_val) {
        Type::DestinationUnreachable -> {
            : uint32; # unused
            original: OriginalDatagram;
        }
        Type::TimeExceeded -> {
            : uint32; # unused
            original: OriginalDatagram;
        }
        Type::ParameterProblem -> {
            pointer: uint8;
            : bytes &size=3; # unused
            original: OriginalDatagram;
        }
        Type::SourceQuench -> {
            : uint32; # unused
            original: OriginalDatagram;
        }
        Type::Redirect -> {
            gateway_address: addr &ipv4;
            original: OriginalDatagram;
        }
        Type::Echo, Type::EchoReply -> {
            identifier: uint16;
            sequence_number: uint16;
            data: bytes &eod;
        }
        Type::Timestamp, Type::TimestampReply -> {
            identifier: uint16;
            sequence_number: uint16;
            originate_timestamp: uint32;
            receive_timestamp: uint32;
            transmit_timestamp: uint32;
        }
        Type::InformationRequest, Type::InformationReply -> {
            identifier: uint16;
            sequence_number: uint16;
        }
    };
};