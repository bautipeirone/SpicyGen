module TFTP_GEMINI;

import spicy;

type Opcode = enum {
    RRQ = 1,
    WRQ = 2,
    DATA = 3,
    ACK = 4,
    ERROR = 5
};

type ErrorCode = enum {
    NotDefined = 0,
    FileNotFound = 1,
    AccessViolation = 2,
    DiskFull = 3,
    IllegalOperation = 4,
    UnknownTID = 5,
    FileAlreadyExists = 6,
    NoSuchUser = 7
};

public type TFTP_Packet = unit {
    opcode: uint16 &convert=Opcode($$);

    switch (self.opcode) {
        Opcode::RRQ, Opcode::WRQ -> {
            filename: bytes &until=b"\0";
            mode: bytes &until=b"\0";
        }
        Opcode::DATA -> {
            block_number: uint16;
            data: bytes &eod;
        }
        Opcode::ACK -> {
            block_number: uint16;
        }
        Opcode::ERROR -> {
            error_code: uint16 &convert=ErrorCode($$);
            error_message: bytes &until=b"\0";
        }
    };
};