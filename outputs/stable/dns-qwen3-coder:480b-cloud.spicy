module DNS;

import spicy;

type QR = enum {
    Query = 0,
    Response = 1,
};

type OpCode = enum {
    QUERY = 0,
    IQUERY = 1,
    STATUS = 2,
};

type RCode = enum {
    NoError = 0,
    FormatError = 1,
    ServerFailure = 2,
    NameError = 3,
    NotImplemented = 4,
    Refused = 5,
};

type Class = enum {
    IN = 1,
    CS = 2,
    CH = 3,
    HS = 4,
};

type TypeValue = enum {
    A = 1,
    NS = 2,
    MD = 3,
    MF = 4,
    CNAME = 5,
    SOA = 6,
    MB = 7,
    MG = 8,
    MR = 9,
    NULL = 10,
    WKS = 11,
    PTR = 12,
    HINFO = 13,
    MINFO = 14,
    MX = 15,
    TXT = 16,
    AXFR = 252,
    MAILB = 253,
    MAILA = 254,
    ANY = 255,
};

public type Message = unit {
    header: Header;
    question: Question[self.header.qdcount];
    answer: RR[self.header.ancount];
    authority: RR[self.header.nscount];
    additional: RR[self.header.arcount];
};

type Header = unit {
    id: uint16;
    flags: bitfield(16) {
        qr: 0;
        opcode: 1..4;
        aa: 5;
        tc: 6;
        rd: 7;
        ra: 8;
        z: 9..11;
        rcode: 12..15;
    } &bit-order=spicy::BitOrder::MSB0;
    qdcount: uint16;
    ancount: uint16;
    nscount: uint16;
    arcount: uint16;
};

type Question = unit {
    qname: Name;
    qtype: uint16 &convert=TypeValue($$);
    qclass: uint16 &convert=Class($$);
};

type RR = unit {
    name: Name;
    type_value: uint16 &convert=TypeValue($$);
    class_value: uint16 &convert=Class($$);
    ttl: uint32;
    rdlength: uint16;
    rdata: bytes &size=self.rdlength;
};

type Name = unit {
    labels: Label[] &until=$$.length == 0;
    : uint8 &size=1 &requires=($$ == 0); # terminating zero
};

type Label = unit {
    length: uint8 &requires=($$ < 64);
    data: bytes &size=self.length;
};