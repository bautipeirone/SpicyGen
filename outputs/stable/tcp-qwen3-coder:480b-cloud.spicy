module TCP_Qwen3;

import spicy;

type ControlBits = unit {
    : bitfield(16) {
        data_offset: 0..3;     # Data Offset (4 bits)
        reserved: 4..9;        # Reserved (6 bits)
        urg: 10;               # URG flag
        ack: 11;               # ACK flag
        psh: 12;               # PSH flag
        rst: 13;               # RST flag
        syn: 14;               # SYN flag
        fin: 15;               # FIN flag
    } &bit-order=spicy::BitOrder::MSB0;
};

public type TCP_Header = unit {
    src_port: uint16;
    dst_port: uint16;
    seq_num: uint32;
    ack_num: uint32;
    control_bits: ControlBits;
    window: uint16;
    checksum: uint16;
    urgent_ptr: uint16;
    # Options parsing - need to calculate remaining header size
    # Basic header is 20 bytes, data_offset tells us total header size in 32-bit words
    options_data: bytes &size=(self.control_bits.data_offset * 4 - 20) if(self.control_bits.data_offset > 5);
};