module TCP_RFC793;

public type TCPHeader = unit {
    src_port: uint16;
    dst_port: uint16;
    seq_num: uint32;
    ack_num: uint32;
    data_offset_and_reserved: uint8;
    flags: uint8;
    window_size: uint16;
    checksum: uint16;
    urgent_pointer: uint16;
    options: TCPOption[] &size=((self.data_offset_and_reserved >> 4) * 4) - 20 if(((self.data_offset_and_reserved >> 4) * 4) > 20);
    data: bytes &eod;
};

type TCPOption = unit {
    kind: uint8;
    length: uint8 if(self.kind == 2 || self.kind == 3 || self.kind == 4); # Options with length field
    value_bytes: bytes &size=(self.length - 2) if(self.kind == 2 || self.kind == 3 || self.kind == 4);
};