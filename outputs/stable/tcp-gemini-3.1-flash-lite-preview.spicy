module TCP_GPT;

import spicy;

type Option = unit {
    kind: uint8;
    switch (self.kind) {
        0 -> : void;
        1 -> : void;
        * -> {
            length: uint8;
            data: bytes &size=self.length - 2;
        }
    };
};

public type TCPHeader = unit {
    source_port: uint16;
    destination_port: uint16;
    sequence_number: uint32;
    acknowledgment_number: uint32;
    
    f: bitfield(16) {
        data_offset: 0..3;
        reserved: 4..9;
        urg: 10;
        ack: 11;
        psh: 12;
        rst: 13;
        syn: 14;
        fin: 15;
    } &bit-order=spicy::BitOrder::MSB0;
    
    window: uint16;
    checksum: uint16;
    urgent_pointer: uint16;
    
    # Data offset is in 32-bit words. Header is at least 5 words (20 bytes).
    # Options start after the 20th byte.
    options: bytes &size=(self.f.data_offset * 4) - 20 if (self.f.data_offset > 5);
    
    data: bytes &eod;
};