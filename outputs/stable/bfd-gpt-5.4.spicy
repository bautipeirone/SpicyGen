module BFD_gpt;

import spicy;

type BFDDiagnostic = enum {
    NoDiagnostic = 0,
    ControlDetectionTimeExpired = 1,
    EchoFunctionFailed = 2,
    NeighborSignaledSessionDown = 3,
    ForwardingPlaneReset = 4,
    PathDown = 5,
    ConcatenatedPathDown = 6,
    AdministrativelyDown = 7,
    ReverseConcatenatedPathDown = 8
};

type BFDState = enum {
    AdminDown = 0,
    Down = 1,
    Init = 2,
    Up = 3
};

type BFDAuthType = enum {
    Reserved = 0,
    SimplePassword = 1,
    KeyedMD5 = 2,
    MeticulousKeyedMD5 = 3,
    KeyedSHA1 = 4,
    MeticulousKeyedSHA1 = 5
};

type BFDFlagsAndLength = unit {
    bits: bitfield(32) {
        version: 0..2;
        diagnostic: 3..7 &convert=BFDDiagnostic($$);
        state: 8..9 &convert=BFDState($$);
        poll: 10;
        final: 11;
        control_plane_independent: 12;
        authentication_present: 13;
        demand: 14;
        multipoint: 15;
        detect_mult: 16..23;
        length: 24..31;
    } &bit-order=spicy::BitOrder::MSB0;
};

type BFDSimplePasswordAuth = unit(auth_len: uint32) {
    auth_key_id: uint8;
    password: bytes &size=(auth_len - 3);
};

type BFDKeyedMD5Auth = unit {
    auth_key_id: uint8;
    reserved: uint8;
    sequence_number: uint32;
    auth_key_digest: bytes &size=16;
};

type BFDKeyedSHA1Auth = unit {
    auth_key_id: uint8;
    reserved: uint8;
    sequence_number: uint32;
    auth_key_hash: bytes &size=20;
};

type BFDAuthSection = unit(auth_section_length: uint32) {
    auth_type: uint8 &convert=BFDAuthType($$);
    auth_len: uint8;
    switch (self.auth_type) {
        BFDAuthType::SimplePassword -> simple_password: BFDSimplePasswordAuth(self.auth_len);
        BFDAuthType::KeyedMD5,
        BFDAuthType::MeticulousKeyedMD5 -> keyed_md5: BFDKeyedMD5Auth;
        BFDAuthType::KeyedSHA1,
        BFDAuthType::MeticulousKeyedSHA1 -> keyed_sha1: BFDKeyedSHA1Auth;
        * -> auth_data: bytes &size=(auth_section_length - 2);
    };
};

type BFDEchoPacket = unit {
    payload: bytes &eod;
};

public type BFD = unit {
    header: BFDFlagsAndLength;
    my_discriminator: uint32;
    your_discriminator: uint32;
    desired_min_tx_interval: uint32;
    required_min_rx_interval: uint32;
    required_min_echo_rx_interval: uint32;
    authentication: BFDAuthSection(self.header.bits.length - 24) if(self.header.bits.authentication_present == 1);
};