module VXLAN_LLM;

public type VXLANPacket = unit {
    # VXLAN Header (8 bytes total)
    header: VXLANHeader;
    
    # Payload (encapsulated frame)
    payload: bytes &eod;
};

type VXLANHeader = unit {
    flags: bitfield(8) {
        reserved1: 0..3;
        i_flag: 4;
        reserved2: 5..7;
    };
    group_policy_id: bytes &size=3;
    vni: uint32 &convert=($$ >> 8);
    reserved2: uint8;
};