module TM_GEMINI;

import spicy;

type PrimaryHeader = unit {
    mcid_vcid_ocf: bitfield(16) {
        version: 0..1;
        scid: 2..11;
        vcid: 12..14;
        ocf_flag: 15;
    } &bit-order=spicy::BitOrder::MSB0;

    mc_frame_count: uint8;
    vc_frame_count: uint8;

    status: bitfield(16) {
        secondary_header_flag: 0;
        sync_flag: 1;
        packet_order_flag: 2;
        segment_length_id: 3..4;
        first_header_pointer: 5..15;
    } &bit-order=spicy::BitOrder::MSB0;
};

type SecondaryHeader = unit {
    id: bitfield(8) {
        version: 0..1;
        length_minus_1: 2..7;
    } &bit-order=spicy::BitOrder::MSB0;

    data: bytes &size=self.id.length_minus_1;
};

type OperationalControlField = unit {
    control_word: bitfield(32) {
        type_flag: 0;
        type_2_report_usage: 1;
        report_data: 2..31;
    } &bit-order=spicy::BitOrder::MSB0;
};

public type TM_Transfer_Frame = unit(frame_length: uint64, has_fecf: bool, has_sdls: bool, security_header_len: uint64, security_trailer_len: uint64) {
    primary_header: PrimaryHeader;

    secondary_header: SecondaryHeader if (self.primary_header.status.secondary_header_flag == 1);

    security_header: bytes &size=security_header_len if (has_sdls);

    data_field: bytes &size=(frame_length
                             - 6
                             - (self.primary_header.status.secondary_header_flag == 1 ? (cast<uint64>(self.secondary_header.id.length_minus_1) + 1) : 0)
                             - (has_sdls ? security_header_len : 0)
                             - (has_sdls ? security_trailer_len : 0)
                             - (self.primary_header.mcid_vcid_ocf.ocf_flag == 1 ? 4 : 0)
                             - (has_fecf ? 2 : 0));

    security_trailer: bytes &size=security_trailer_len if (has_sdls && security_trailer_len > 0);

    ocf: OperationalControlField if (self.primary_header.mcid_vcid_ocf.ocf_flag == 1);

    fecf: uint16 if (has_fecf);
};