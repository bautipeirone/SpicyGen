module TELNET_gemini;

import spicy;

type CommandCode = enum {
    SE = 240,
    NOP = 241,
    DM = 242,
    BRK = 243,
    IP = 244,
    AO = 245,
    AYT = 246,
    EC = 247,
    EL = 248,
    GA = 249,
    SB = 250,
    WILL = 251,
    WONT = 252,
    DO = 253,
    DONT = 254,
    IAC = 255,
};

public type Messages = unit {
    msgs: Message[] &eod;
};

type Message = unit {
    switch {
        -> cmd: Command;
        -> data: uint8;
    };
};

type Command = unit {
    : b"\xff";
    code: uint8 &convert=CommandCode($$);
    switch (self.code) {
        CommandCode::SB -> sub: Subnegotiation;
        CommandCode::WILL,
        CommandCode::WONT,
        CommandCode::DO,
        CommandCode::DONT -> option: uint8;
        CommandCode::IAC -> : void;
        * -> : void;
    };
};

type Subnegotiation = unit {
    option: uint8;
    parameters: bytes &until=b"\xff\xf0";
};