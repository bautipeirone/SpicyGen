module TFTP_gemini;

import spicy;

type Opcode = enum {
    RRQ = 1,
    WRQ = 2,
    DATA = 3,
    ACK = 4,
    ERROR = 5,
};

type ErrorCode = enum {
    NOT_DEFINED = 0,
    FILE_NOT_FOUND = 1,
    ACCESS_VIOLATION = 2,
    DISK_FULL = 3,
    ILLEGAL_OPERATION = 4,
    UNKNOWN_TID = 5,
    FILE_EXISTS = 6,
    NO_SUCH_USER = 7,
};

type Request = unit {
    filename: bytes &until=b"\x00";
    mode: bytes &until=b"\x00";
};

type Data = unit {
    block_num: uint16;
    data_field: bytes &eod;
};

type Ack = unit {
    block_num: uint16;
};

type Error = unit {
    error_code: uint16 &convert=ErrorCode($$);
    error_msg: bytes &until=b"\x00";
};

public type Packet = unit {
    opcode: uint16 &convert=Opcode($$);
    switch (self.opcode) {
        Opcode::RRQ -> rrq: Request;
        Opcode::WRQ -> wrq: Request;
        Opcode::DATA -> data_pkt: Data;
        Opcode::ACK -> ack_pkt: Ack;
        Opcode::ERROR -> error_pkt: Error;
    };
};