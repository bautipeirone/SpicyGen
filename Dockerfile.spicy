FROM python:3.12-slim-bookworm

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PATH="/app/.venv/bin:/opt/spicy/bin:${PATH}"

ARG SPICY_VERSION=v1.16.0
ARG SPICY_DEB_URL=https://github.com/zeek/spicy/releases/download/${SPICY_VERSION}/spicy_linux_debian12.deb

COPY docker/install_app.sh /tmp/install_app.sh
COPY pyproject.toml uv.lock ./
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl g++ make \
    && curl -fsSL "${SPICY_DEB_URL}" -o /tmp/spicy.deb \
    && apt-get install -y --no-install-recommends /tmp/spicy.deb \
    && rm -f /tmp/spicy.deb \
    && rm -rf /var/lib/apt/lists/* \
    && /bin/sh /tmp/install_app.sh

COPY . .
RUN uv sync --locked --no-dev
